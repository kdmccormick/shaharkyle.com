---
/*
 * Shahar & Kyle - save the date.
 *
 * The drawing is the site. It was photographed, cropped and knocked out onto
 * transparency (tools/process_flyer.py), so what you see is graphite sitting
 * directly on the page's own paper - not a white card floating on a
 * background. It is left at the angle it was shot at, on purpose.
 *
 * The background is an aged page carrying wood-grain contours drawn like
 * tattoo linework - see grain-and-ink-background.html, which is where the look
 * comes from. src/inkgrain.js grows the rings; src/glow.js lays a pool of
 * clean paper over them behind every block marked `data-clearing`, so the
 * grain runs behind the page but not through the words. The pools have to be
 * measured in the browser: they need the positions the content actually landed
 * at, which depend on viewport width and font loading.
 */
const photos = [
  { src: '/images/seine.jpg',    alt: 'On a bridge over the Seine at sunset' },
  { src: '/images/forest.jpg',   alt: 'A kiss on the cheek in the winter woods' },
  { src: '/images/ornament.jpg', alt: 'The two of us reflected in a silver ornament' },
  { src: '/images/yurt.jpg',     alt: 'Bundled up outside a yurt in the snow' },
];

const MAPS = 'https://maps.google.com/?q=Arts+at+the+Armory,+191+Highland+Ave,+Somerville,+MA+02143';

// Marcy is generated by tools/draw_marcy.py and inlined rather than linked, so
// her tail and paws can be animated from the stylesheet.
import marcySvg from '../marcy-run.svg?raw';
import marcySleepSvg from '../marcy-sleep.svg?raw';
import bananaSvg from '../banana.svg?raw';

---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Shahar & Kyle are getting married — June 5, 2027 at Arts at the Armory in Somerville, MA." />
  <title>Shahar &amp; Kyle are getting married</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Special+Elite&display=swap" rel="stylesheet" />
</head>

<body>

<!--
  Filter definitions. Kept out of the flow in a zero-size svg; they are
  referenced from CSS by id, never rendered here.
-->
<svg class="defs-only" aria-hidden="true" focusable="false">
  <filter id="roughInk" x="-4%" y="-4%" width="108%" height="108%"
          color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="2"
                  seed="3" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="5"
                       xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>

<!-- ═══ PASSWORD WALL ═══════════════════════════════════ -->
<div id="pw-wall">
  <div class="pw-box">
    <img class="pw-curl tl" src="/images/orn-corner.svg" alt="" aria-hidden="true" />
    <img class="pw-curl br" src="/images/orn-corner.svg" alt="" aria-hidden="true" />
    <h2 class="pw-title">Shahar <span class="amp">&amp;</span> Kyle</h2>
    <p class="pw-sub">still being drawn</p>
    <div class="pw-prompt">
      <span class="pw-caret">&rsaquo;</span>
      <input type="password" id="pw-input" autocomplete="off" maxlength="12" spellcheck="false" placeholder="access code" />
    </div>
    <p id="pw-error" class="pw-error"></p>
    <p class="pw-hint">press enter</p>
  </div>
</div>

<div class="page">

  <!--
    The background, bottom to top: aged paper with its vignette and foxing,
    the fractal-noise tooth over it, then the wood-grain ink. All three are
    fixed to the viewport - the drawing is a window onto a plank, and the noise
    is scale-free, so there is nothing to gain from stretching either down a
    page thousands of pixels tall.
  -->
  <div class="bg" aria-hidden="true">
    <div class="paper-age"></div>
    <div class="paper-tooth">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <filter id="paperNoise">
          <feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="3"
                        seed="7" stitchTiles="stitch"/>
          <feColorMatrix values="0 0 0 0 .45  0 0 0 0 .38  0 0 0 0 .28  0 0 0 .5 0"/>
        </filter>
        <rect width="100%" height="100%" filter="url(#paperNoise)"/>
      </svg>
    </div>
    <svg class="ink" id="ink" xmlns="http://www.w3.org/2000/svg"></svg>
  </div>

  <!--
    The star chart. Scrolls with the page, unlike the grain behind it: the
    figures are placed in the margins beside the content, so they have to know
    where the content is, and the pools below scroll too.
  -->
  <svg class="sky" id="sky" aria-hidden="true"></svg>

  <!-- the pools of clean paper the text is read on, over the grain -->
  <canvas id="glow" aria-hidden="true"></canvas>

  <main>

    <!-- ═══ THE DRAWING ═════════════════════════════════ -->
    <section class="flyer" data-clearing>
      <picture>
        <source
          type="image/webp"
          srcset="/images/flyer-ink-900.webp 900w, /images/flyer-ink-1500.webp 1500w"
          sizes="(max-width: 620px) 88vw, (max-width: 760px) 70vw, 536px" />
        <img
          src="/images/flyer-ink.png"
          width="1500" height="1645"
          alt="A hand-drawn flyer: Save the Date — we're getting married on June 5, 2027, around 5PM, at Arts at the Armory, 191 Highland Ave, Somerville MA, over a pencil drawing of the Armory building."
          fetchpriority="high" />
      </picture>
    </section>

    <!-- ═══ THE TWO OF US ═══════════════════════════════ -->
    <section class="strip-wrap" data-clearing>
      <div class="marquee">
        <!--
          One set of photos, twice, so there is something to look at before
          the script runs. It clones this further at runtime until the row is
          wider than the screen - see PHOTO MARQUEE below for why.
        -->
        <div class="marquee-track" id="marquee-track" data-count={photos.length}>
          {photos.map(p => <img src={p.src} alt={p.alt} />)}
          {photos.map(p => <img src={p.src} alt="" aria-hidden="true" />)}
        </div>
      </div>
    </section>

    <!--
      Everything the flyer says, in text a screen reader and a phone can use.
      One block, so the grain parts around it once and it sits in a single
      pool of light rather than three.
    -->
    <section class="bubble" data-clearing="snug">
      <h1>Shahar <span class="amp">&amp;</span> Kyle</h1>
      <p class="line">are getting married</p>

      <p class="fact">Saturday, June 5, 2027</p>
      <p class="line">around 5 in the afternoon</p>

      <p class="fact">
        <a href="https://artsatthearmory.org/" target="_blank" rel="noopener">Arts at the Armory</a>
      </p>
      <p class="line">
        <a href={MAPS} target="_blank" rel="noopener">191 Highland Ave &middot; Somerville, MA</a>
      </p>
    </section>

    <!-- ═══ TELL US WHERE TO SEND THE REAL ONE ══════════ -->
    <!--
      Netlify picks this form up from the built HTML and collects the entries;
      the hidden form-name field is how it knows which form a POST belongs to,
      and bot-field is a honeypot Netlify watches for spam. The submit goes over
      fetch so the page can answer inline, but the form still works as a plain
      POST if the script never runs.
    -->
    <section class="ask" data-clearing="snug">
      <p class="ask-sub">Let us know where to send your invitation</p>

      <form
        class="ask-form"
        name="save-the-date"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        id="rsvp-form"
      >
        <input type="hidden" name="form-name" value="save-the-date" />
        <p class="hp">
          <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="field">
          <span>Your name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <!--
          Neither of these is `required` on its own: one or the other will do,
          and `required` cannot say that. The rule is enforced on submit, and
          the status line below the button carries the message.
        -->
        <label class="field">
          <span>Mailing address</span>
          <textarea name="address" rows="3" autocomplete="street-address"></textarea>
        </label>

        <label class="field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" />
        </label>

        <button type="submit">Submit</button>
        <p class="ask-status" id="rsvp-status" role="status" aria-live="polite"></p>
      </form>
    </section>

  </main>

  <footer data-clearing="snug">
    <p class="foot-line">
      Made with &lt;3 by Shahar and Kyle, with supervision from Marcy
    </p>
    <a class="foot-src" href="https://github.com/kdmccormick/shaharkyle.com" target="_blank" rel="noopener">source code on github</a>
  </footer>

  <!-- ═══ MARCY, AND A BANANA ═════════════════════════════
    Inside .page and absolutely positioned, so the two of them belong to the
    document and scroll with it. Both ride a hidden loop drawn over the whole
    page; see src/marcy.js. She carries both poses and the state class picks
    one.
    ═══════════════════════════════════════════════════════ -->
  <div class="critters" id="critters">

    <div class="critter" data-marcy role="button" tabindex="0" aria-label="Marcy, asleep. Wake her up.">
      <div class="pose pose-sleep" set:html={marcySleepSvg}></div>
      <div class="pose pose-wake"  set:html={marcySvg}></div>
    </div>

    <div class="critter" data-banana role="button" tabindex="0" aria-label="Throw the banana">
      <Fragment set:html={bananaSvg} />
    </div>

    <!-- her noises. Placed by JS above whichever pose is showing. -->
    <p class="marcy-say" data-say aria-live="polite"><span></span></p>

  </div>

</div>

</body>
</html>

<style is:global>
/* ══ TOKENS ═══════════════════════════════════════════════
   Graphite on paper, lit like early morning: cool overhead,
   warm down at the horizon. The flyer is knocked out to
   transparency, so this sky is literally what you see through
   the drawing - everything else is tuned to it.
   ═════════════════════════════════════════════════════════ */
:root {
  /*
   * Shahar means dawn. The page is the sky just before one: deeper overhead,
   * going lighter down at the horizon.
   *
   * How light is a compromise pulling three ways. Too dark and the graphite
   * grain vanishes into it and the step up to the lit blocks is a wall; too
   * light and the off-white star chart has nothing to show against. Around
   * here the grain reads at ~2.8:1, the chart at ~4.7:1, and the sky sits
   * ~4.5:1 off the lit surface instead of the 8:1 cliff it was.
   */
  /*
   * Shahar means dawn. The page is the sky just before one - deep overhead,
   * lightening towards the horizon - with the wood grain inked over it and
   * pools of warm dawn light where the content sits.
   */
  --sky-top:    #3a4d6d;
  --sky-mid:    #4c6183;
  --sky-low:    #667b98;
  --sky-edge:   #2e3f59;   /* deeper, right at the margins */

  --ink:        #171410;   /* tattoo black; the grain is drawn in this */
  --ink-soft:   #423b34;
  /* darkened along with the paper going golden - at the old #655c50 it fell
     to 4.2:1 on it, under AA. 5.2:1 here. */
  --ink-faint:  #574e43;

  --accent:     #1f5561;   /* deep teal, the one spot of colour */
  --rule:       rgba(23,20,16,0.3);

  /*
   * The dawn light behind each block, in four stacked passes so it fades out
   * over a distance rather than in a step. The core is what the text actually
   * sits on, so it is nearly opaque; the rest is spill, thinning and widening
   * as it goes. Warmer and deeper than it was - low sun rather than daylight -
   * which cost --ink-faint some contrast and is why that moved too.
   */
  --glow-core:  rgba(234,207,148,0.94);
  --glow-mid:   rgba(224,188,126,0.54);
  --glow-halo:  rgba(210,164,94,0.28);
  --glow-outer: rgba(190,140,70,0.16);
  /* the same tan as the core of the light, opaque, for solid fills */
  --tan:        #f6ecd4;

  /* the star chart: off-white, so it shows on the open sky and disappears
     into the pools of light wherever there is text over it */
  --chart:      #efece1;

  --font-hand:  'Permanent Marker', 'Comic Sans MS', cursive;
  --font-type:  'Special Elite', 'Courier New', Courier, monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  font-size: 18px;
  /*
   * The dawn sky, deeper overhead and at the margins. Everything that gives it
   * depth and texture - the tooth, the grain, the pools of light - is in the
   * layers on top of it.
   */
  background-color: var(--sky-mid);
  background-image:
    linear-gradient(to right,  var(--sky-edge) 0, transparent max(22px, calc((100% - 900px) / 2))),
    linear-gradient(to left,   var(--sky-edge) 0, transparent max(22px, calc((100% - 900px) / 2))),
    linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 52%, var(--sky-low) 100%);
  background-repeat: no-repeat;
  background-attachment: fixed;
}

body {
  font-family: var(--font-type);
  line-height: 1.6;
  color: var(--ink);
  background-color: transparent;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }
.amp { color: var(--accent); }
.dot { color: var(--ink-faint); margin: 0 0.35rem; }

/* ══ PASSWORD WALL ════════════════════════════════════════ */
#pw-wall {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  /* opaque, so the page behind it is genuinely hidden rather than tinted */
  background: linear-gradient(180deg, var(--sky-top), var(--sky-low));
}
.pw-box {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.3rem;
  width: 100%;
  max-width: 380px;
  padding: 2.75rem 2.5rem;
  /* the box's edge is a drawn line, stretched to fit */
  border-image: url('/images/orn-frame.svg') 30 / 30px / 0 stretch;
  border-width: 30px;
  border-style: solid;
}
.pw-curl {
  position: absolute;
  width: 76px;
  opacity: 0.55;
  pointer-events: none;
}
.pw-curl.tl { top: -26px;    left: -26px; }
.pw-curl.br { bottom: -26px; right: -26px; transform: rotate(180deg); }
.pw-title {
  font-family: var(--font-hand);
  font-weight: 400;
  font-size: 2.1rem;
  line-height: 1.15;
}
.pw-sub { color: var(--ink-soft); font-size: 0.82rem; margin-bottom: 1.1rem; }
.pw-prompt {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  border-bottom: 1.5px solid var(--rule);
  padding-bottom: 0.4rem;
}
.pw-caret {
  font-family: var(--font-type);
  color: var(--accent);
  font-size: 1.1rem;
  animation: blink 1.1s step-end infinite;
}
@keyframes blink { 0%,100% { opacity: 1 } 50% { opacity: 0 } }
#pw-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--ink);
  font-family: var(--font-type);
  font-size: 0.95rem;
  letter-spacing: 0.2em;
  caret-color: var(--accent);
}
#pw-input::placeholder { color: var(--ink-faint); letter-spacing: 0.1em; }
.pw-error {
  font-family: var(--font-type);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--accent);
  min-height: 1.3em;
  margin-top: 0.5rem;
}
.pw-hint { font-size: 0.72rem; color: var(--ink-faint); }

/* ══ LAYOUT ═══════════════════════════════════════════════ */
.page { position: relative; overflow-x: clip; }

.defs-only { position: absolute; width: 0; height: 0; overflow: hidden; }

/* Three layers filling the same box, all under the content and painted at the
   element's own pixel size: the light, then the grain over it, then the star
   flares on top. Stacked by document order - they all sit at z-index 0. */
/* ══ THE BACKGROUND STACK ═════════════════════════════════
   Fixed behind everything: paper, then its tooth, then the ink. */
.bg {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}
.bg > * { position: absolute; inset: 0; }

/* Vignette into the corners, and a scatter of pale motes. On the aged-paper
   version these were warm brown foxing spots; over a night sky the same brown
   reads as dirt, so they are cool and light here instead - specks of dust
   caught in the last of the dark. */
.paper-age {
  background:
    radial-gradient(circle at 12% 68%, rgba(226,236,255,.20) 0 1.5px, transparent 3px),
    radial-gradient(circle at 63% 22%, rgba(226,236,255,.17) 0 1.5px, transparent 3px),
    radial-gradient(circle at 87% 47%, rgba(226,236,255,.15) 0 2px, transparent 4px),
    radial-gradient(circle at 41% 88%, rgba(226,236,255,.14) 0 1.5px, transparent 3px),
    radial-gradient(circle at 29% 36%, rgba(226,236,255,.12) 0 1.5px, transparent 3px),
    radial-gradient(ellipse at 20% 15%, transparent 55%, rgba(0,0,0,.10) 100%),
    radial-gradient(ellipse at 80% 90%, transparent 55%, rgba(0,0,0,.12) 100%);
}

.paper-tooth {
  opacity: 0.55;
  mix-blend-mode: multiply;
}
.paper-tooth svg { display: block; width: 100%; height: 100%; }

.bg .ink { width: 100%; height: 100%; opacity: 0.9; }

/*
 * The lines draw themselves on, staggered by ring index so the tree grows from
 * the middle out. pathLength="1" on every path is what lets one dash rule cover
 * rings of wildly different circumference.
 *
 * The broken rings are excluded: their dasharray is the gap pattern that makes
 * them look like skipped ink, and overwriting it to animate them would erase
 * the effect.
 */
@media (prefers-reduced-motion: no-preference) {
  .ink path:not(.is-broken) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ink-draw 2.4s ease-out forwards;
    animation-delay: calc(var(--i) * 0.045s);
  }
  @keyframes ink-draw { to { stroke-dashoffset: 0; } }

  .ink path.is-broken { opacity: 0; animation: ink-fade .9s ease-out forwards;
                        animation-delay: calc(var(--i) * 0.045s); }
  @keyframes ink-fade { to { opacity: 1; } }
}

/* ══ THE STAR CHART ═══════════════════════════════════════
 * Over the grain, under the pools - so the pools cover the stars wherever
 * there is text, and the chart is only ever seen in the open.
 *
 * Every element carries its own delay as --d, worked out in
 * constellations.js where the counts are known. The rules here only say what
 * happens, never when.
 * ═════════════════════════════════════════════════════════ */
.sky {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  overflow: visible;
}
.s-dot   { fill: var(--chart); }
.s-core  { fill: var(--chart); }
.s-edge  { stroke: var(--chart); stroke-width: 1.3; fill: none; opacity: 0.85; }
.s-loose .s-dot,
.s-loose .s-core { opacity: 0.72; }

/* The resting state here is deliberately the sparkle's own 0% frame, so the
   loop can start without the flare jumping when it takes over. */
.s-flare {
  stroke: var(--chart);
  stroke-width: 1;
  fill: none;
  stroke-linecap: round;
  transform-box: fill-box;
  transform-origin: 50% 50%;
  opacity: 0.42;
  transform: scale(0.86);
}

@media (prefers-reduced-motion: no-preference) {
  /*
   * The stars pop in first, scattered rather than swept, then every figure
   * joins itself up a segment at a time. `backwards` matters: without it each
   * element sits at full size through its delay and the whole chart is simply
   * there from the start.
   */
  .sky:not(.is-settled) .s-dot,
  .sky:not(.is-settled) .s-core {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: star-pop 0.5s cubic-bezier(.2,1.6,.4,1) backwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes star-pop {
    from { transform: scale(0); opacity: 0; }
    60%  { transform: scale(1.35); opacity: 1; }
    to   { transform: scale(1); opacity: 1; }
  }

  /*
   * One segment at a time, in a shuffled order across every figure, each
   * fading up and staying put. `both` is what makes it stay: with `backwards`
   * alone the segment reverted to the stylesheet's own opacity the instant it
   * finished, so they flashed on and vanished, then all reappeared together
   * when .is-settled dropped the rule.
   */
  .sky:not(.is-settled) .s-edge {
    animation: edge-in 0.5s ease-out both;
    animation-delay: var(--d, 0s);
  }
  @keyframes edge-in { from { opacity: 0; } to { opacity: 0.85; } }

  /*
   * The flares fade in with their star and then sparkle on, each with its own
   * phase from --t so they wander rather than pulsing together. Two animations
   * on the one element: the fade, then the loop handed the baton 0.6s later.
   * flare-in ends exactly on the sparkle's 0% frame, which is why the loop can
   * pick up without a jump.
   */
  .s-flare {
    animation: sparkle 5.5s ease-in-out infinite;
    animation-delay: var(--t, 0s);
  }
  .sky:not(.is-settled) .s-flare {
    animation: flare-in 0.6s ease-out backwards,
               sparkle 5.5s ease-in-out infinite;
    animation-delay: var(--d, 0s), calc(var(--d, 0s) + 0.6s + var(--t, 0s));
  }
  @keyframes flare-in { from { opacity: 0; } to { opacity: 0.42; } }
  @keyframes sparkle {
    0%, 100% { opacity: 0.42; transform: scale(0.86); }
    50%      { opacity: 0.9;  transform: scale(1.12); }
  }
}

/* The pools of clean paper the content is read on. Over the ink, under the
   text - the grain runs behind the page but not through the words. */
#glow {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  user-select: none;
}

main {
  position: relative;
  z-index: 1;
  max-width: 760px;
  margin: 0 auto;
  padding: clamp(1.75rem, 5vw, 3.5rem) 1.25rem 2rem;
}

/* Everything the grain has to flow around also has to sit on top of it - and
   on top of Marcy, so she passes behind the drawing and the text. */
.flyer, .bubble, .ask, .strip-wrap, footer { position: relative; z-index: 2; }

/* ══ MARCY AND THE BANANA ═════════════════════════════════ */
/* Absolute inside .page, not fixed to the viewport: she is part of the
   document and scrolls with it, so she stays where she was on the page
   rather than following you down it. */
.critters {
  position: absolute;
  inset: 0;
  /* Above the content rather than behind it. She used to pass behind the
     flyer, which was prettier, but you now have to be able to click her and
     she cannot be under the text to do that. */
  z-index: 3;
  pointer-events: none;
  overflow: hidden;
}
/* Positioned by JS. The element's own origin is its centre, so the transform
   can be a plain translate to a point on the path. */
.critter {
  position: absolute;
  top: 0;
  left: 0;
  will-change: transform;
  pointer-events: auto;    /* the two things you can actually click */
  cursor: pointer;
}
.critter:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

/* Both poses are in the DOM; the state class on the layer picks one. */
.pose { display: none; }
.critters.is-snoozing .pose-sleep { display: block; }
.critters.is-waiting  .pose-wake,
.critters.is-chasing  .pose-wake  { display: block; }

.marcy-run   { width: 120px; height: auto; margin: -52px 0 0 -60px; overflow: visible; }
.marcy-sleep { width: 150px; height: auto; margin: -56px 0 0 -75px; overflow: visible; }
.banana-fly  { width: 62px;  height: auto; margin: -21px 0 0 -31px; overflow: visible; }
/* the banana arcs across when thrown, and tumbles on the way */
.critter[data-banana] { transition: transform 0.55s cubic-bezier(.3,.9,.4,1); }

/* she already has one in the sleeping drawing; the loose one is the real prop */
.marcy-sleep .m-banana,
.marcy-sleep .m-banana-stem { display: none; }

/* the snoozing pose, in the same black as the rest of her */
.marcy-sleep .m-fur-fill { fill: #17140f; }
.marcy-sleep .m-fur      { fill: #17140f; stroke: #17140f; }
.marcy-sleep .m-tuft     { fill: #4a4139; }
.marcy-sleep .m-bib      { fill: #e6e0d2; }
.marcy-sleep .m-nose     { fill: #7d5a5e; }
.marcy-sleep .m-shut {
  fill: none;
  stroke: #d8d2c4;
  stroke-width: 2.2;
  stroke-linecap: round;
}
.marcy-sleep .m-mouth {
  fill: none;
  stroke: #4a4139;
  stroke-width: 1.6;
  stroke-linecap: round;
}
.marcy-sleep .m-whisk path {
  fill: none;
  stroke: #f2ede0;
  stroke-width: 1.2;
  opacity: 0.7;
  stroke-linecap: round;
}
.marcy-sleep .m-zzz {
  fill: none;
  stroke: var(--ink-soft);
  stroke-width: 2.4;
  stroke-linecap: round;
  animation: zzz-float 4.2s ease-in-out infinite;
}
@keyframes zzz-float {
  0%, 100% { opacity: 0.25; transform: translateY(2px); }
  50%      { opacity: 0.7;  transform: translateY(-4px); }
}

/* ── her noises ──────────────────────────────────────── */
/* A zero-size box at the point JS puts it, so the text centres on her head
   however long it is. */
.marcy-say {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
  will-change: transform;
}
.marcy-say span {
  white-space: nowrap;
  font-family: var(--font-hand);
  font-size: 1.1rem;
  color: var(--ink);
  opacity: 0;
  transform: translateY(6px) rotate(-3deg);
  transition: opacity 0.18s ease, transform 0.22s cubic-bezier(.2,1.5,.5,1);
}
.marcy-say.is-on span { opacity: 1; transform: translateY(0) rotate(-3deg); }

/* She is almost entirely silhouette, so nearly everything is the one black. */
.marcy-run .m-fur-fill { fill: #17140f; }
.marcy-run .m-fur      { fill: #17140f; stroke: #17140f; }
.marcy-run .m-tuft     { fill: #4a4139; }   /* inside the ears */
.marcy-run .m-bib      { fill: #e6e0d2; }   /* the wisp on her chest */
.marcy-run .m-eye      { fill: #c3c765; }
.marcy-run .m-pupil    { fill: #14120e; }
.marcy-run .m-glint    { fill: #fdfbf3; }
.marcy-run .m-nose     { fill: #7d5a5e; }
.marcy-run .m-mouth {
  fill: none;
  stroke: #4a4139;
  stroke-width: 1.6;
  stroke-linecap: round;
}
.marcy-run .m-whisk path {
  fill: none;
  stroke: #f2ede0;
  stroke-width: 1.2;
  opacity: 0.8;
  stroke-linecap: round;
}

.m-banana      { fill: #e8c33f; stroke: #8a7526; stroke-width: 1.6; stroke-linejoin: round; }
.m-banana-line { fill: none; stroke: #c9a833; stroke-width: 1.6; stroke-linecap: round; }
.m-banana-stem { fill: none; stroke: #6b5a1e; stroke-width: 3; stroke-linecap: round; }
.m-banana-tip  { fill: #6b5a1e; }

/* the splits between her toes, scored into the pad */
.m-toe { fill: none; stroke: #38302a; stroke-width: 1.3; stroke-linecap: round; }

/*
 * A deliberately simple trot: the whole cat bobs, the tail sways, and the paws
 * take turns lifting. A full four-legged gait cycle was tried and read as a
 * scuttle at this size - the bob alone is more legible and much cuter.
 * `transform-box: fill-box` is what makes transform-origin resolve against each
 * shape's own box rather than the whole SVG viewport.
 */
.is-chasing .marcy-run { animation: marcy-bob 0.42s ease-in-out infinite; }
@keyframes marcy-bob {
  0%, 100% { transform: translateY(0)     scaleY(1); }
  50%      { transform: translateY(-3.5px) scaleY(0.97); }
}

.is-chasing .marcy-run .m-tail {
  transform-box: fill-box;
  transform-origin: 88% 82%;
  animation: marcy-swish 1.15s ease-in-out infinite;
}
@keyframes marcy-swish {
  0%, 100% { transform: rotate(-7deg); }
  50%      { transform: rotate(9deg); }
}

.is-chasing .marcy-run .m-leg {
  transform-box: fill-box;
  transform-origin: 50% 10%;
  animation: marcy-step 0.42s ease-in-out infinite;
}
.is-chasing .marcy-run .m-leg-a { animation-delay: 0s; }
.is-chasing .marcy-run .m-leg-b { animation-delay: -0.105s; }
.is-chasing .marcy-run .m-leg-c { animation-delay: -0.21s; }
.is-chasing .marcy-run .m-leg-d { animation-delay: -0.315s; }
@keyframes marcy-step {
  0%, 100% { transform: translateY(0)   rotate(0deg); }
  50%      { transform: translateY(-4px) rotate(-7deg); }
}

/*
 * Waiting: sitting still, blinking now and then. step-end so the lid snaps
 * shut and open rather than easing, which reads as a blink instead of a
 * slow squint. The two eyes share one animation - a cat winking at you is a
 * different message entirely.
 */
.is-waiting .marcy-run .m-eye,
.is-waiting .marcy-run .m-pupil,
.is-waiting .marcy-run .m-glint {
  transform-box: fill-box;
  transform-origin: 50% 50%;
  animation: marcy-blink 5.2s step-end infinite;
}
@keyframes marcy-blink {
  0%, 92%, 100% { transform: scaleY(1); }
  94%, 97%      { transform: scaleY(0.08); }
}

/* A blink on demand, when you click her. Outranks the ambient loop above by
   being one class more specific, and the script takes it off again when it
   has run - left on, a finished animation would win and she would never
   blink on her own again. */
.critters.is-waiting .critter.is-blinking .marcy-run .m-eye,
.critters.is-waiting .critter.is-blinking .marcy-run .m-pupil,
.critters.is-waiting .critter.is-blinking .marcy-run .m-glint {
  animation: marcy-wink 0.34s step-end 1;
}
@keyframes marcy-wink {
  0%, 100%  { transform: scaleY(1); }
  15%, 70%  { transform: scaleY(0.08); }
}

/* ══ THE FLYER ════════════════════════════════════════════ */
/* The section carries the width, not the image: it is the [data-clearing] the
   grain parts around, so if the two disagree the light lands in the wrong
   place. On a phone it goes back to nearly full width - a quarter off an
   already narrow column leaves the handwriting too small to read. */
.flyer { width: 75%; margin-inline: auto; }
.flyer img { display: block; width: 100%; height: auto; }

/* ══ THE BUBBLE ═══════════════════════════════════════════
   Names, date, time, venue, address - one block, alternating between the
   hand for the things you need to remember and the typewriter for the
   things that qualify them. */
.bubble { text-align: center; margin-top: clamp(1.5rem, 4vw, 2.5rem); }
.bubble h1 {
  font-family: var(--font-hand);
  font-weight: 400;
  font-size: clamp(2.4rem, 8vw, 4rem);
  line-height: 1.05;
}

/* the marker lines: date, venue */
.fact {
  font-family: var(--font-hand);
  font-size: 1.45rem;
  line-height: 1.3;
  margin-top: 1.5rem;
}
.fact a { color: var(--ink); border-bottom: 2px solid rgba(31,85,97,0.45); }
.fact a:hover { color: var(--accent); text-decoration: none; }

/* the typed lines under them. The tracking leaves a gap after the last
   letter that centring counts as text, so it is nudged back by the same
   amount. */
.line {
  margin-top: 0.55rem;
  font-family: var(--font-type);
  font-size: 0.78rem;
  letter-spacing: 0.34em;
  text-indent: 0.34em;
  color: var(--ink-soft);
}
.line a { color: inherit; border-bottom: 1px solid rgba(31,85,97,0.4); }
.line a:hover { color: var(--accent); text-decoration: none; }


/* ══ THE FORM ═════════════════════════════════════════════ */
/* The padding is doing real work: the clearing is measured from this box, so
   padding pushes the heading further inside it and out of the grain's
   feathered edge. A margin would move the clearing along with the text. */
.ask {
  text-align: center;
  margin-top: clamp(2.5rem, 7vw, 4.5rem);
  padding-top: 1.1rem;
}
.ask-sub {
  margin: 0 auto 1.9rem;
  max-width: 36ch;
  font-family: var(--font-hand);
  font-size: 1.2rem;
  line-height: 1.3;
}
.ask-form { max-width: 430px; margin: 0 auto; text-align: left; }
.hp { position: absolute; left: -9999px; }   /* honeypot, for bots only */

.field { display: block; margin-bottom: 1.15rem; }
.field > span {
  display: block;
  margin-bottom: 0.35rem;
  font-size: 0.68rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.field input,
.field textarea {
  width: 100%;
  padding: 0.6rem 0.7rem;
  font-family: var(--font-type);
  font-size: 0.95rem;
  color: var(--ink);
  background: rgba(255,255,255,0.4);
  border: 2px solid var(--ink);
  border-radius: 2px;
  outline: none;
  resize: vertical;
}
.field input:focus,
.field textarea:focus {
  border-color: var(--accent);
  background: rgba(255,255,255,0.62);
}
.field textarea::placeholder { color: var(--ink-faint); line-height: 1.45; }


.ask-form button {
  display: block;
  margin: 1.6rem auto 0;
  padding: 0.6rem 2rem;
  font-family: var(--font-hand);
  font-size: 1.1rem;
  color: var(--tan);
  background: var(--ink);
  border: 2px solid var(--ink);
  border-radius: 2px;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.ask-form button:hover { background: var(--accent); border-color: var(--accent); }
.ask-form button[disabled] { opacity: 0.55; cursor: default; }

.ask-status {
  min-height: 1.4em;
  margin-top: 0.9rem;
  text-align: center;
  font-size: 0.8rem;
  color: var(--accent);
}
.ask-status.is-error { color: #8f2f22; }

/* ══ PHOTO STRIP ══════════════════════════════════════════
 * Every photo renders at the same height, tiled flush, drifting left.
 * The track is shifted by exactly the width of one set of photos, so the
 * next set lands where the last one started and the seam never shows.
 * That width is measured at runtime - see PHOTO MARQUEE in the script.
 * ═════════════════════════════════════════════════════════ */
/* It sits inside `main` for ordering, but breaks out of its 760px column to
   run the full width of the page the way it did before. */
.strip-wrap {
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-top: clamp(2rem, 5vw, 3rem);
}
.marquee {
  width: 100%;
  height: clamp(200px, 28vh, 310px);
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
          mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
}
.marquee-track {
  display: flex;
  height: 100%;
  width: max-content;
  will-change: transform;
  animation: marquee-drift var(--dur, 120s) linear infinite;
}
/*
 * Spacing is a trailing margin, not `gap`. With `gap` the track has 2N-1
 * gaps, so -50% lands half a gap short of the second copy and the loop
 * visibly jumps. A margin on every image gives 2N even gaps - exact.
 */
.marquee-track img {
  height: 100%;
  width: auto;
  flex: none;
  display: block;
  object-fit: cover;
  margin-right: 6px;
  filter: saturate(0.9) contrast(1.02);
}
/* --shift is one set's width in px, set by the script. Until it lands the
   strip simply holds still rather than drifting by a wrong amount. */
@keyframes marquee-drift {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(calc(-1 * var(--shift, 0px)), 0, 0); }
}

/* ══ FOOTER ═══════════════════════════════════════════════ */
footer { text-align: center; padding: 2.5rem 1.5rem 3rem; color: var(--ink-soft); }
.marcy-sleep {
  width: 140px;
  height: auto;
  display: block;
  margin: 0 auto 1rem;
  color: var(--ink-soft);
}
.foot-line { font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; }
.foot-src {
  display: inline-block;
  margin-top: 0.9rem;
  font-size: 0.58rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
.foot-src:hover { color: var(--accent); text-decoration: none; }

/* ══ RESPONSIVE ═══════════════════════════════════════════ */
/*
 * Narrow screens have no side margin at all - the content is the width - so
 * the only place the grain can show is between the blocks. Give it somewhere
 * to be: the gaps roughly double and the page ends in open paper at both ends,
 * so each block reads as sitting on the plank rather than covering it. The
 * pools of paper shrink to match; see the `tight` factor in glow.js.
 */
@media (max-width: 1100px) {
  /* The head holds the heart; the foot holds a row of three, so it is
     deeper. */
  .page { padding: clamp(7rem, 22vw, 9rem) 0 clamp(9rem, 28vw, 12rem); }

  /*
   * Margin, not padding. The footer is a [data-clearing], so padding-top
   * would be inside its own clearing and the gap between it and the form
   * would stay shut. A margin is real space between the two clearings,
   * which is what the middle row of figures sits in.
   */
  footer { margin-top: clamp(9rem, 30vw, 12rem); }
}

@media (max-width: 760px) {
  .strip-wrap { margin-top: clamp(4rem, 12vw, 5.5rem); }
  .bubble { margin-top: clamp(4rem, 12vw, 5.5rem); }
  .ask { margin-top: clamp(4.5rem, 14vw, 6rem); }
}

@media (max-width: 620px) {
  html { font-size: 17px; }
  main { padding: 1.25rem 1rem 1.5rem; }
  .flyer { width: 94%; }
  .fact { font-size: 1.2rem; }
  .marcy-sleep { width: 118px; }
}

@media (prefers-reduced-motion: reduce) {
  .zzz { animation: none; }
  .marquee-track { animation: none; }
  .marquee { overflow-x: auto; }
}
</style>

<script>
import { installInkGrain } from '../inkgrain.js';
import { installGlow } from '../glow.js';
import { installSky } from '../sky.js';
import { installMarcy } from '../marcy.js';

// ── THE BACKGROUND ────────────────────────────────────────
// Wood-grain rings over an aged page, and pools of clean paper over those for
// the content to be read on. Colours come from the stylesheet so they are
// stated once.
const css = getComputedStyle(document.documentElement);
const pick = (name, fallback) =>
  css.getPropertyValue(name).trim() || fallback;

const grain = installInkGrain(document.getElementById('ink'), {
  seed: 20270605,
  ink: pick('--ink', '#171410'),
});

/*
 * The chart waits for the grain to finish drawing itself on. That moment is
 * derived rather than guessed: the rings are staggered by index and each takes
 * a fixed time, both set in the stylesheet, so the last one lands at
 * delay x (count - 1) + duration. Retuning the grain moves the chart with it.
 */
const INK_STAGGER = 0.045;
const INK_DRAW = 2.4;
const inkDone = INK_DRAW + (grain.count - 1) * INK_STAGGER;

installSky(document.getElementById('sky'), {
  seed: 20270605,
  begin: inkDone + 0.3,
});

const repaintGrain = installGlow(document.getElementById('glow'), {
  outer: pick('--glow-outer', ''),
  core: pick('--glow-core', ''),
  mid:  pick('--glow-mid',  ''),
  halo: pick('--glow-halo', ''),
});

/* ── THE CAT ───────────────────────────────────────────────
 * Snoozing at the bottom of the screen. Click her to wake her, click the
 * banana to throw it, and if she is awake when it lands she will go and get
 * it. She handles her own states; nothing else on the page drives her.
 * See src/marcy.js.
 */
installMarcy(document.getElementById('critters'));

// ── PASSWORD WALL ─────────────────────────────────────────
const KEY  = 'sk-auth-v1';
const PASS = '060527';
const wall = document.getElementById('pw-wall');
const inp  = document.getElementById('pw-input');
const err  = document.getElementById('pw-error');

const unlock = () => { wall.style.display = 'none'; };
if (localStorage.getItem(KEY) === '1') unlock();

inp.addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  if (inp.value === PASS) {
    localStorage.setItem(KEY, '1');
    unlock();
  } else {
    err.textContent = '[ not quite ]';
    inp.value = '';
    setTimeout(() => { err.textContent = ''; }, 2000);
  }
});
if (wall.style.display !== 'none') inp.focus();

/* ── THE FORM ──────────────────────────────────────────────
 * Posted over fetch so the page can answer inline instead of bouncing to
 * Netlify's own success page. Without JS the form still submits normally.
 *
 * A name is required, plus at least one way to reach them. `required` can
 * only demand a field outright, not one-of-two, so that half is checked here.
 * The browser handles the name and runs first: this listener does not fire
 * until the built-in validation has passed.
 * ───────────────────────────────────────────────────────── */
const form   = document.getElementById('rsvp-form');
const status = document.getElementById('rsvp-status');
const email  = form.querySelector('[name="email"]');
const addr   = form.querySelector('[name="address"]');

const hasContact = () => Boolean(email.value.trim() || addr.value.trim());

// Stop nagging the moment they start filling one in.
for (const el of [email, addr]) {
  el.addEventListener('input', () => {
    if (hasContact() && status.classList.contains('is-error')) {
      status.classList.remove('is-error');
      status.textContent = '';
    }
  });
}

form.addEventListener('submit', async e => {
  e.preventDefault();

  if (!hasContact()) {
    status.classList.add('is-error');
    status.textContent = 'We need an address or an email to send it to.';
    addr.focus();
    return;
  }
  status.classList.remove('is-error');

  const btn = form.querySelector('button');
  btn.disabled = true;
  status.textContent = 'sending…';

  try {
    const res = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(new FormData(form)).toString(),
    });
    if (!res.ok) throw new Error(res.status);
    form.innerHTML = '<p class="ask-status">Got it — see you on June 5th.</p>';
    repaintGrain();   // the form collapsed, so its clearing moved
  } catch {
    status.textContent = 'That did not go through. Email us instead?';
    btn.disabled = false;
  }
});

/* ── PHOTO MARQUEE ─────────────────────────────────────────
 * The strip is shifted left by exactly one set of photos, so the following
 * set arrives where the last one began and the loop is invisible.
 *
 * For that to hold, the track has to stay wider than the screen for the whole
 * shift - it needs viewport + one set. Two sets of four photos come to about
 * 1000px each, which is fine on a phone but leaves bare paper trailing the
 * last photo on a wide window: the very thing that made the strip look only
 * as long as the page. So the set is cloned until there is enough of it, which
 * depends on the window and on how wide the photos turn out to be once loaded.
 * ───────────────────────────────────────────────────────── */
const track = document.getElementById('marquee-track');
const PX_PER_SEC = 22;
const perSet = Number(track.dataset.count) || 1;
const baseSet = [...track.children].slice(0, perSet);

function layoutMarquee() {
  // width of one set, margins included
  const setWidth = baseSet.reduce((w, img) =>
    w + img.getBoundingClientRect().width
      + parseFloat(getComputedStyle(img).marginRight || 0), 0);

  // images have no size yet; a later load event brings us back
  if (setWidth < 1) return;

  const need = Math.max(2, Math.ceil(window.innerWidth / setWidth) + 1);
  for (let have = track.children.length / perSet; have < need; have++) {
    for (const img of baseSet) {
      const copy = img.cloneNode(true);
      copy.alt = '';
      copy.setAttribute('aria-hidden', 'true');
      track.appendChild(copy);
    }
  }

  track.style.setProperty('--shift', `${setWidth}px`);
  track.style.setProperty('--dur', `${setWidth / PX_PER_SEC}s`);
}

layoutMarquee();
window.addEventListener('load', layoutMarquee);
window.addEventListener('resize', layoutMarquee, { passive: true });
for (const img of baseSet) {
  if (!img.complete) img.addEventListener('load', layoutMarquee, { once: true });
}
</script>
