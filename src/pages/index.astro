<style is:global>
/* ══ TOKENS ═══════════════════════════════════════════════
   Sampled from a sunset on the Seine and the Armory's
   brick, string lights, and greenery.
   ═════════════════════════════════════════════════════════ */
:root {
  --ink:        #23201b;
  --ink-soft:   #4e473d;
  --ink-faint:  #8a8071;

  --paper:      #f4eee2;
  --paper-2:    #ece3d2;
  --paper-edge: #d9cdb6;

  --dusk:       #4e5d70;
  --dusk-2:     #7b8b9c;
  --haze:       #a9b0b3;

  --amber:      #cf8f37;
  --gold:       #e8bd6d;
  --peach:      #e6b48c;

  --rust:       #a9563a;
  --terra:      #c07a54;
  --sage:       #7d8f6b;
  --plum:       #6d4c5d;

  --rule:       rgba(35,32,27,0.16);
  --rule-soft:  rgba(35,32,27,0.09);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; font-size: 18px; }

body {
  font-family: 'Newsreader', Georgia, serif;
  font-size: 1rem;
  line-height: 1.65;
  color: var(--ink);
  background-color: var(--paper);
  /* faint laid-paper tooth */
  background-image:
    repeating-linear-gradient(0deg,  rgba(35,32,27,0.014) 0 1px, transparent 1px 3px),
    repeating-linear-gradient(90deg, rgba(35,32,27,0.010) 0 1px, transparent 1px 4px);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--rust); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }

.dot { color: var(--ink-faint); margin: 0 0.5rem; }

/* ══ PASSWORD WALL ════════════════════════════════════════ */
#pw-wall {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: var(--paper);
  background-image:
    linear-gradient(to bottom, rgba(78,93,112,0.16), transparent 45%),
    repeating-linear-gradient(0deg, rgba(35,32,27,0.014) 0 1px, transparent 1px 3px);
}
.pw-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.35rem;
  width: 100%;
  max-width: 350px;
  padding: 2.5rem 2.25rem;
  background: var(--paper);
  border: 1px solid var(--paper-edge);
  outline: 3px double var(--paper-edge);
  outline-offset: 5px;
  box-shadow: 6px 7px 0 rgba(35,32,27,0.10);
}
.pw-plate {
  font-family: 'Space Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
.pw-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 1.85rem;
  letter-spacing: 0.03em;
  line-height: 1.15;
  color: var(--ink);
  margin-top: 0.4rem;
}
.pw-sub {
  font-style: italic;
  color: var(--ink-soft);
  font-size: 0.92rem;
  margin-bottom: 0.9rem;
}
.pw-prompt {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 0.4rem;
}
.pw-caret {
  font-family: 'Space Mono', monospace;
  color: var(--rust);
  font-size: 1.1rem;
  animation: blink 1.1s step-end infinite;
}
@keyframes blink { 0%,100% { opacity: 1 } 50% { opacity: 0 } }
#pw-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--ink);
  font-family: 'Space Mono', monospace;
  font-size: 0.95rem;
  letter-spacing: 0.22em;
  caret-color: var(--rust);
}
#pw-input::placeholder { color: var(--ink-faint); letter-spacing: 0.12em; }
.pw-error {
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  color: var(--rust);
  min-height: 1.3em;
  margin-top: 0.5rem;
}
.pw-hint {
  font-style: italic;
  font-size: 0.78rem;
  color: var(--ink-faint);
}

/* ══ NAV ══════════════════════════════════════════════════ */
#site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 0.7rem 1.75rem;
  transition: background 0.35s, box-shadow 0.35s;
}
#site-header.scrolled {
  background: rgba(244,238,226,0.93);
  backdrop-filter: blur(9px);
  box-shadow: 0 1px 0 var(--rule);
}
nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem 1rem;
}
.nav-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  font-size: 1.15rem;
  letter-spacing: 0.22em;
  color: var(--ink);
}
.nav-title:hover { text-decoration: none; color: var(--rust); }
nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.1rem; }
nav ul li a {
  font-family: 'Space Mono', monospace;
  font-size: 0.66rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-soft);
  padding: 0.35rem 0.6rem;
  transition: color 0.15s;
}
nav ul li a:hover { color: var(--rust); text-decoration: none; }
.rsvp-link {
  border: 1px solid var(--ink);
  color: var(--ink) !important;
}
.rsvp-link:hover { background: var(--ink); color: var(--paper) !important; }

/* nav sits over the dusk sky until you scroll */
#site-header:not(.scrolled) .nav-title { color: #f6efe3; }
#site-header:not(.scrolled) nav ul li a { color: rgba(246,239,227,0.82); }
#site-header:not(.scrolled) nav ul li a:hover { color: #fff; }
#site-header:not(.scrolled) .rsvp-link {
  border-color: rgba(246,239,227,0.6);
  color: #f6efe3 !important;
}
#site-header:not(.scrolled) .rsvp-link:hover {
  background: rgba(246,239,227,0.92);
  color: var(--ink) !important;
}

/* ══ HERO ═════════════════════════════════════════════════ */
#hero {
  --band-h: 190px;
  position: relative;
  margin-top: -3.6rem;   /* pull the dusk band up behind the sticky nav */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.4rem;
  padding-bottom: 3rem;
}

/* ── dusk band behind the nav and the lights ── */
.skyband {
  position: absolute;
  inset: 0 0 auto 0;
  height: var(--band-h);
  background: linear-gradient(
    to bottom,
    #46536580  0%,
    #6a7684cc 30%,
    #a89a8ae6 58%,
    #d9b58c 78%,
    var(--paper) 100%
  );
  background-color: var(--paper);
  z-index: 0;
}
.festoon {
  position: absolute;
  top: 3.4rem;
  left: 0;
  z-index: 3;
  width: 100%;
  height: 54px;
}

/* ── the photo strip ──
 * Every photo is rendered at the same height, tiled flush, drifting left.
 * The list is duplicated in the markup so the loop is seamless: the track
 * animates to -50%, which lands exactly on the start of the second copy.
 */
.marquee {
  position: relative;
  z-index: 1;
  width: 100%;
  height: clamp(220px, 32vh, 330px);
  overflow: hidden;
  margin-top: var(--band-h);
  background: var(--paper-2);
  /* soften both ends so photos don't hard-cut at the viewport edge */
  -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
          mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
}
.marquee-track {
  display: flex;
  height: 100%;
  width: max-content;
  will-change: transform;
  animation: marquee-drift var(--dur, 120s) linear infinite;
}
/*
 * Spacing is a trailing margin, not `gap`. With `gap` the track has 2N-1
 * gaps, so -50% lands half a gap short of the second copy and the loop
 * visibly jumps. A margin on every image gives 2N even gaps — exact.
 */
.marquee-track img {
  height: 100%;
  width: auto;
  flex: none;
  display: block;
  object-fit: cover;
  margin-right: 5px;
}
@keyframes marquee-drift {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(-50%, 0, 0); }
}
/* let people stop and look */
.marquee:hover .marquee-track,
.marquee:focus-within .marquee-track { animation-play-state: paused; }
.festoon .wire {
  fill: none;
  stroke: rgba(30,26,22,0.45);
  stroke-width: 1.2;
}
.bulb line   { stroke: rgba(30,26,22,0.4); stroke-width: 1.1; }
.bulb circle {
  fill: var(--gold);
  stroke: rgba(120,80,30,0.35);
  stroke-width: 0.8;
  filter: drop-shadow(0 0 5px rgba(232,189,109,0.85));
  animation: bulb-glow 4.5s ease-in-out infinite;
}
@keyframes bulb-glow {
  0%, 100% { opacity: 0.82; }
  50%      { opacity: 1; }
}

/* names sit on the paper below the photo — quiet, not shouting over it */
.hero-text {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.7rem;
  margin-top: -1.5rem;
  padding: 0 1.5rem;
}
.hero-eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 0.58rem;
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
#hero h1 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: clamp(2.6rem, 8vw, 4.6rem);
  line-height: 1.1;
  letter-spacing: 0.02em;
  color: var(--ink);
}
#hero h1 .amp {
  font-style: italic;
  font-weight: 300;
  color: var(--amber);
  padding: 0 0.12em;
}
.hero-meta {
  font-family: 'Space Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-soft);
  max-width: 34rem;
  line-height: 2.1;
}
.hero-meta .dot { color: var(--ink-faint); }

/* ── specimen plate ── */
.plate {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 900px;
  margin: 0;
  text-align: center;
  color: var(--ink);
}
.plate-svg { width: 100%; height: auto; display: block; }
.plate-svg .ink { color: var(--ink); }
.plate-num {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  fill: var(--ink-soft);
}
.plate-name {
  font-family: 'Newsreader', serif;
  font-style: italic;
  font-size: 12.5px;
  fill: var(--ink-faint);
}
.plate figcaption {
  font-style: italic;
  font-size: 0.9rem;
  color: var(--ink-soft);
  margin-top: 0.5rem;
  padding-top: 0.9rem;
  border-top: 1px solid var(--rule-soft);
  display: inline-block;
}

.hero-cta {
  position: relative;
  z-index: 2;
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--ink);
  border: 1px solid var(--ink);
  padding: 0.65rem 2.1rem;
  transition: background 0.18s, color 0.18s;
}
.hero-cta:hover { background: var(--ink); color: var(--paper); text-decoration: none; }

/* ══ MARGINALIA STRIP ═════════════════════════════════════ */
.strip {
  max-width: 640px;
  margin: 1rem auto 0;
  padding: 0 1.5rem;
  color: var(--ink-soft);
}
.strip-svg { width: 100%; height: auto; display: block; }
.cat-fill  { fill: #26231e; }
.cat-eye   { fill: var(--gold); animation: cat-blink 7s step-end infinite; }
.cat-pupil { fill: #26231e; }
.cat-lash  { stroke: var(--gold); }
@keyframes cat-blink { 0%, 96% { opacity: 1 } 97%, 99% { opacity: 0.06 } 100% { opacity: 1 } }
.steam { animation: steam-rise 3.4s ease-in-out infinite; }
@keyframes steam-rise {
  0%, 100% { opacity: 0.15; transform: translateY(2px); }
  50%      { opacity: 0.55; transform: translateY(-3px); }
}
.zzz { animation: zzz-float 4.2s ease-in-out infinite; }
@keyframes zzz-float {
  0%, 100% { opacity: 0.25; transform: translateY(2px); }
  50%      { opacity: 0.65; transform: translateY(-3px); }
}

/* ══ CARDS ════════════════════════════════════════════════ */
main {
  max-width: 720px;
  margin: 0 auto;
  padding: 1.5rem 1.5rem 4rem;
  display: flex;
  flex-direction: column;
  gap: 2.6rem;
}

/* field notes, tacked to the wall a hair off-square */
.card {
  position: relative;
  background: var(--paper);
  border: 1px solid var(--paper-edge);
  padding: 2.1rem 2.3rem;
  box-shadow: 5px 6px 0 rgba(35,32,27,0.09);
}
/* a second hairline inside, like a printed plate border */
.card::before {
  content: '';
  position: absolute;
  inset: 6px;
  border: 1px solid var(--rule-soft);
  pointer-events: none;
}

#details  { --rot: -0.4deg;  --accent: var(--rust);  }
#us       { --rot:  0.3deg;  --accent: var(--amber); }
#timeline { --rot: -0.22deg; --accent: var(--sage);  }
#rsvp     { --rot:  0.35deg; --accent: var(--plum);  }

.card h2 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  font-size: 1.7rem;
  line-height: 1.2;
  letter-spacing: 0.02em;
  color: var(--ink);
  margin-bottom: 1.5rem;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid var(--rule);
  display: flex;
  align-items: baseline;
  gap: 0.85rem;
  flex-wrap: wrap;
}
.plate-tag {
  font-family: 'Space Mono', monospace;
  font-weight: 400;
  font-size: 0.55rem;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--ink-faint);
  white-space: nowrap;
}
.card h3 {
  font-family: 'Space Mono', monospace;
  font-weight: 400;
  font-size: 0.62rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 0.55rem;
}

/* ══ WHEN & WHERE ═════════════════════════════════════════ */
/* the coffee ring is not decorative, it is documentary */
#details::after {
  content: '';
  position: absolute;
  top: -20px;
  right: 30px;
  width: 78px;
  height: 78px;
  border: 2.5px solid var(--rust);
  border-radius: 50%;
  opacity: 0.10;
  pointer-events: none;
}
.details-grid {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  gap: 0 2.2rem;
  text-align: center;
  align-items: start;
}
.detail-rule {
  align-self: stretch;
  background: repeating-linear-gradient(
    to bottom,
    var(--rule) 0 5px,
    transparent 5px 10px
  );
}
.detail-big {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  font-size: 1.5rem;
  line-height: 1.3;
  letter-spacing: 0.01em;
  color: var(--ink);
}
.detail-big a { color: inherit; border-bottom: 1px solid rgba(169,86,58,0.45); }
.detail-big a:hover { color: var(--rust); text-decoration: none; }
.detail-year {
  font-family: 'Space Mono', monospace;
  font-size: 1.05rem;
  letter-spacing: 0.28em;
  color: var(--amber);
  margin-top: 0.15rem;
}
.detail-sub {
  margin-top: 0.6rem;
  font-size: 0.92rem;
  line-height: 1.55;
  color: var(--ink-soft);
}
.arch {
  width: 74px;
  height: auto;
  display: block;
  margin: 0 auto 0.5rem;
  color: var(--terra);
  opacity: 0.75;
}
.details-note {
  margin-top: 1.8rem;
  padding-top: 1.1rem;
  border-top: 1px solid var(--rule-soft);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--ink-soft);
  text-align: center;
}

/* ══ STORY TIMELINE ═══════════════════════════════════════ */
.story-timeline {
  list-style: none;
  position: relative;
  padding-left: 1.85rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.story-timeline::before {
  content: '';
  position: absolute;
  left: 5px;
  top: 8px;
  bottom: 8px;
  width: 1px;
  background: var(--rule);
}
.story-timeline li { position: relative; }
.story-timeline li::before {
  content: '';
  position: absolute;
  left: -1.85rem;
  top: 7px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--paper);
  border: 1.5px solid var(--ink-faint);
}
.story-timeline li:nth-child(2n)::before { border-color: var(--sage); }
.story-timeline li:nth-child(3n)::before { border-color: var(--terra); }

/* the wedding gets the filled star */
.story-timeline li.st-future::before {
  background: var(--amber);
  border-color: var(--amber);
  box-shadow: 0 0 0 3px rgba(207,143,55,0.18);
}
.st-date {
  display: block;
  font-family: 'Space Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 0.15rem;
}
.st-title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-weight: 500;
  font-size: 1.22rem !important;
  letter-spacing: 0.01em !important;
  text-transform: none !important;
  color: var(--ink) !important;
  margin-bottom: 0.15rem !important;
}
.st-body p { color: var(--ink-soft); font-size: 0.96rem; }
.st-future .st-title { color: var(--rust) !important; }

/* ══ RSVP ═════════════════════════════════════════════════ */
.rsvp-dead {
  font-family: 'Space Mono', monospace;
  font-size: 0.66rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 1.6rem;
}
.rsvp-form { display: flex; flex-direction: column; gap: 1.15rem; }
.fg { display: flex; flex-direction: column; gap: 0.35rem; }
.fg label {
  font-family: 'Space Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
.req { color: var(--rust); }
.fg input[type="text"],
.fg input[type="email"],
.fg input[type="number"],
.fg textarea {
  width: 100%;
  padding: 0.55rem 0.7rem;
  background: rgba(255,255,255,0.55);
  border: 1px solid var(--paper-edge);
  color: var(--ink);
  font-family: 'Newsreader', serif;
  font-size: 1rem;
  caret-color: var(--rust);
  transition: border-color 0.15s, background 0.15s;
  -webkit-appearance: none;
  border-radius: 0;
}
.fg input:focus, .fg textarea:focus {
  outline: none;
  border-color: var(--rust);
  background: #fff;
}
.fg textarea { resize: vertical; }
.fg input[type="number"] { max-width: 7rem; }
.radios { display: flex; gap: 1.6rem; flex-wrap: wrap; }
.rl {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  cursor: pointer;
  font-family: 'Newsreader', serif;
  font-size: 1rem;
  color: var(--ink);
}
.rl input[type="radio"] { accent-color: var(--rust); }
.submit-btn {
  align-self: flex-start;
  padding: 0.65rem 2rem;
  background: transparent;
  border: 1px solid var(--ink);
  color: var(--ink);
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  cursor: pointer;
  border-radius: 0;
  transition: background 0.18s, color 0.18s;
}
.submit-btn:hover { background: var(--ink); color: var(--paper); }

/* ══ FOOTER ═══════════════════════════════════════════════ */
footer {
  text-align: center;
  padding: 1rem 1.5rem 3rem;
  color: var(--ink-soft);
}
.marcy-sleep {
  width: 148px;
  height: auto;
  display: block;
  margin: 0 auto 1rem;
  color: var(--ink-soft);
}
.foot-line {
  font-family: 'Space Mono', monospace;
  font-size: 0.64rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.foot-marcy {
  font-style: italic;
  font-size: 0.8rem;
  color: var(--ink-faint);
  margin-top: 0.4rem;
}
.foot-src {
  display: inline-block;
  margin-top: 1rem;
  font-family: 'Space Mono', monospace;
  font-size: 0.58rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
.foot-src:hover { color: var(--rust); text-decoration: none; }

/* ══ FADE-IN (keeps each card's tilt) ═════════════════════ */
.fade-in {
  opacity: 0;
  transform: translateY(18px) rotate(var(--rot, 0deg));
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0) rotate(var(--rot, 0deg));
}

/* ══ RESPONSIVE ═══════════════════════════════════════════ */
@media (max-width: 700px) {
  #hero { --band-h: 150px; }
  .marquee { height: clamp(180px, 26vh, 240px); }

  html { font-size: 17px; }
  #hero { gap: 1.9rem; padding-bottom: 2.5rem; }
  .festoon { top: 3rem; height: 44px; }
  .card { padding: 1.6rem 1.25rem; box-shadow: 3px 4px 0 rgba(35,32,27,0.09); }
  .card h2 { font-size: 1.25rem; }
  .details-grid { grid-template-columns: 1fr; gap: 1.6rem 0; }
  .detail-rule {
    height: 1px;
    background: repeating-linear-gradient(to right, var(--rule) 0 5px, transparent 5px 10px);
  }
  .radios { flex-direction: column; gap: 0.55rem; }
  .strip { padding: 0 0.75rem; }
  .marcy-sleep { width: 120px; }
  .hero-meta { font-size: 0.6rem; letter-spacing: 0.12em; }
}

/* the plate gets tight on small screens — let it scroll rather than shrink to nothing */
@media (max-width: 520px) {
  .plate { overflow-x: auto; }
  .plate-svg { min-width: 520px; }
}

@media (prefers-reduced-motion: reduce) {
  .bulb circle, .steam, .zzz, .cat-eye { animation: none; }
  .marquee-track { animation: none; }
  .marquee { overflow-x: auto; }   /* still scrollable by hand */
  .fade-in { transition: none; }
  html { scroll-behavior: auto; }
}
</style>

<script>
// ── PASSWORD WALL ─────────────────────────────────────────
const KEY  = 'sk-auth-v1';
const PASS = '060527';
const wall = document.getElementById('pw-wall');
const inp  = document.getElementById('pw-input');
const err  = document.getElementById('pw-error');

const unlock = () => { wall.style.display = 'none'; };
if (localStorage.getItem(KEY) === '1') unlock();

inp.addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  if (inp.value === PASS) {
    localStorage.setItem(KEY, '1');
    unlock();
  } else {
    err.textContent = '[ not quite ]';
    inp.value = '';
    setTimeout(() => { err.textContent = ''; }, 2000);
  }
});
if (wall.style.display !== 'none') inp.focus();

// ── NAV ───────────────────────────────────────────────────
// Light over the dusk band, ink once you scroll past it.
const hdr = document.getElementById('site-header');
const onScroll = () => hdr.classList.toggle('scrolled', window.scrollY > 120);
onScroll();
window.addEventListener('scroll', onScroll, { passive: true });

// ── PHOTO MARQUEE ─────────────────────────────────────────
// Duration is derived from the track width so the strip drifts at a fixed
// px/sec no matter how many photos are in the list.
const track = document.getElementById('marquee-track');
const PX_PER_SEC = 22;

function setMarqueeSpeed() {
  const half = track.scrollWidth / 2;
  if (half > 0) track.style.setProperty('--dur', `${half / PX_PER_SEC}s`);
}

setMarqueeSpeed();
window.addEventListener('load', setMarqueeSpeed);
window.addEventListener('resize', setMarqueeSpeed, { passive: true });
// images finishing individually can change the width too
track.querySelectorAll('img').forEach(img => {
  if (!img.complete) img.addEventListener('load', setMarqueeSpeed, { once: true });
});

// ── FADE-IN ───────────────────────────────────────────────
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
  });
}, { threshold: 0.08 });
document.querySelectorAll('.fade-in').forEach(el => io.observe(el));

// ── RSVP CONDITIONAL FIELDS ───────────────────────────────
const extra = ['r-guests','r-diet','r-song'].map(id => document.getElementById(id));
document.querySelectorAll('input[name="attending"]').forEach(r =>
  r.addEventListener('change', () => {
    const yes = document.querySelector('input[name="attending"]:checked')?.value === 'yes';
    extra.forEach(el => { el.style.display = yes ? 'flex' : 'none'; });
  })
);
</script>
