---
/*
 * The scrolling photo strip.
 *
 * To add a photo: resize it to 900px tall, drop it in public/images/, and
 * add a line here. Order is left-to-right. Any aspect ratio is fine — they
 * are tiled at equal height and the strip scrolls at a constant speed
 * regardless of how many there are.
 *
 *   sips --resampleHeight 900 -s formatOptions 80 <in>.jpg --out public/images/<name>.jpg
 */
const photos = [
  { src: '/images/seine.jpg',    alt: 'On a bridge over the Seine at sunset' },
  { src: '/images/forest.jpg',   alt: 'A kiss on the cheek in the winter woods' },
  { src: '/images/ornament.jpg', alt: 'The two of us reflected in a silver ornament' },
  { src: '/images/yurt.jpg',     alt: 'Bundled up outside a yurt in the snow' },
];

const MAPS = 'https://maps.google.com/?q=Arts+at+the+Armory,+191+Highland+Ave,+Somerville,+MA+02143';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Shahar & Kyle are getting married — June 5, 2027 at Arts at the Armory in Somerville, MA." />
  <title>Shahar &amp; Kyle</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400..500;1,6..72,400&family=Space+Mono:wght@400&display=swap" rel="stylesheet" />
</head>

<body>

<!-- ═══ PASSWORD WALL ═══════════════════════════════════ -->
<div id="pw-wall">
  <div class="pw-box">
    <h2 class="pw-title">Shahar &amp; Kyle</h2>
    <p class="pw-sub">still under construction</p>
    <div class="pw-prompt">
      <span class="pw-caret">&rsaquo;</span>
      <input type="password" id="pw-input" autocomplete="off" maxlength="12" spellcheck="false" placeholder="access code" />
    </div>
    <p id="pw-error" class="pw-error"></p>
    <p class="pw-hint">press enter</p>
  </div>
</div>

<!-- ═══ PHOTOS, LIT ═════════════════════════════════════ -->
<div class="strip-wrap">
  <div class="marquee" id="marquee">
    <div class="marquee-track" id="marquee-track">
      {photos.map(p => <img src={p.src} alt={p.alt} />)}
      {photos.map(p => <img src={p.src} alt="" aria-hidden="true" />)}
    </div>
  </div>

  <!-- festoon lights, borrowed from the Armory ceiling, hung over the photos -->
  <svg class="festoon" viewBox="0 0 1200 58" preserveAspectRatio="none" aria-hidden="true">
    <path class="wire"
      d="M0,6 Q100,44 200,10 Q300,44 400,10 Q500,44 600,10 Q700,44 800,10 Q900,44 1000,10 Q1100,44 1200,6"/>
    <g class="bulbs">
      <g class="bulb" style="animation-delay:0.0s"><line x1="50"   y1="22" x2="50"   y2="27"/><circle cx="50"   cy="31" r="4.5"/></g>
      <g class="bulb" style="animation-delay:1.3s"><line x1="100"  y1="27" x2="100"  y2="32"/><circle cx="100"  cy="36" r="4.5"/></g>
      <g class="bulb" style="animation-delay:0.6s"><line x1="150"  y1="23" x2="150"  y2="28"/><circle cx="150"  cy="32" r="4.5"/></g>
      <g class="bulb" style="animation-delay:2.1s"><line x1="250"  y1="22" x2="250"  y2="27"/><circle cx="250"  cy="31" r="4.5"/></g>
      <g class="bulb" style="animation-delay:0.9s"><line x1="300"  y1="27" x2="300"  y2="32"/><circle cx="300"  cy="36" r="4.5"/></g>
      <g class="bulb" style="animation-delay:1.7s"><line x1="350"  y1="23" x2="350"  y2="28"/><circle cx="350"  cy="32" r="4.5"/></g>
      <g class="bulb" style="animation-delay:0.3s"><line x1="450"  y1="22" x2="450"  y2="27"/><circle cx="450"  cy="31" r="4.5"/></g>
      <g class="bulb" style="animation-delay:2.4s"><line x1="500"  y1="27" x2="500"  y2="32"/><circle cx="500"  cy="36" r="4.5"/></g>
      <g class="bulb" style="animation-delay:1.1s"><line x1="550"  y1="23" x2="550"  y2="28"/><circle cx="550"  cy="32" r="4.5"/></g>
      <g class="bulb" style="animation-delay:1.9s"><line x1="650"  y1="22" x2="650"  y2="27"/><circle cx="650"  cy="31" r="4.5"/></g>
      <g class="bulb" style="animation-delay:0.5s"><line x1="700"  y1="27" x2="700"  y2="32"/><circle cx="700"  cy="36" r="4.5"/></g>
      <g class="bulb" style="animation-delay:2.7s"><line x1="750"  y1="23" x2="750"  y2="28"/><circle cx="750"  cy="32" r="4.5"/></g>
      <g class="bulb" style="animation-delay:1.5s"><line x1="850"  y1="22" x2="850"  y2="27"/><circle cx="850"  cy="31" r="4.5"/></g>
      <g class="bulb" style="animation-delay:0.2s"><line x1="900"  y1="27" x2="900"  y2="32"/><circle cx="900"  cy="36" r="4.5"/></g>
      <g class="bulb" style="animation-delay:2.2s"><line x1="950"  y1="23" x2="950"  y2="28"/><circle cx="950"  cy="32" r="4.5"/></g>
      <g class="bulb" style="animation-delay:0.8s"><line x1="1050" y1="22" x2="1050" y2="27"/><circle cx="1050" cy="31" r="4.5"/></g>
      <g class="bulb" style="animation-delay:1.6s"><line x1="1100" y1="27" x2="1100" y2="32"/><circle cx="1100" cy="36" r="4.5"/></g>
      <g class="bulb" style="animation-delay:0.4s"><line x1="1150" y1="23" x2="1150" y2="28"/><circle cx="1150" cy="32" r="4.5"/></g>
    </g>
  </svg>
</div>

<!-- ═══ SAVE THE DATE ═══════════════════════════════════ -->
<main>

  <header class="titles">
    <h1>Shahar <span class="amp">&amp;</span> Kyle</h1>
    <p class="save">save the date</p>
  </header>

  <section class="card fade-in">
    <figure class="venue">
      <img src="/images/armory.jpg" alt="The main hall at Arts at the Armory, strung with lights" />
    </figure>

    <div class="facts">
      <div class="fact">
        <h2>when</h2>
        <p class="big">Saturday, 5 June 2027</p>
        <p class="sub">doors at 5:00 pm</p>
      </div>

      <div class="rule"></div>

      <div class="fact">
        <h2>where</h2>
        <p class="big"><a href={MAPS} target="_blank" rel="noopener">Arts at the Armory</a></p>
        <p class="sub">191 Highland Ave<br/>Somerville, MA 02143</p>
      </div>
    </div>
  </section>

</main>

<footer>
