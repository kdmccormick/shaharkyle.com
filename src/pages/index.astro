            d="M22,60 C10,46 18,26 40,21 C60,16 84,18 102,24 C120,30 130,44 124,56 C118,66 96,64 74,62 C54,60 32,66 22,60 Z"/>
      <path d="M124,56 C137,54 146,46 142,37 C139,31 130,32 129,39 C128,45 134,47 137,42" stroke-width="1.9"/>
      <path d="M139,49 C142,51 144,53 145,56" stroke-width="0.7" opacity="0.45"/>
      <path class="cat-fill"
            d="M44,46 C34,46 27,40 27,33 C27,29 29,26 32,24
               C31,20 30,17 31,14 C34,16 37,18 39,20
               C43,18 49,18 53,20 C55,18 58,16 61,14
               C62,17 61,20 60,24 C63,26 65,29 65,33 C65,40 56,46 44,46 Z"/>
      <path d="M34,20 C33,17 33,15 32,13" stroke-width="0.7" opacity="0.55"/>
      <path d="M58,20 C59,17 59,15 60,13" stroke-width="0.7" opacity="0.55"/>
      <path d="M35,31 C37,33 40,33 42,31" stroke-width="1.2" class="cat-lash"/>
      <path d="M50,31 C52,33 55,33 57,31" stroke-width="1.2" class="cat-lash"/>
      <path d="M44,37 L46,39 L48,37" stroke-width="1"/>
      <path class="cat-whisker" d="M32,38 C26,39 22,41 19,43" stroke-width="0.7"/>
      <path class="cat-whisker" d="M60,38 C66,39 70,41 73,43" stroke-width="0.7"/>
      <path class="cat-bib" d="M72,45 C66,48 64,54 66,59 C70,62 79,61 81,57 C82,51 78,46 72,45 Z"/>
      <path d="M62,22 C70,19 82,19 92,22"   stroke-width="0.8" opacity="0.45"/>
      <path d="M96,26 C106,28 114,34 118,40" stroke-width="0.8" opacity="0.35"/>
      <path d="M26,62 C23,64 21,67 21,70"   stroke-width="0.8" opacity="0.4"/>
      <path d="M48,64 C47,67 47,70 48,73"   stroke-width="0.8" opacity="0.35"/>
      <path d="M92,62 C93,65 95,68 97,70"   stroke-width="0.8" opacity="0.3"/>
      <path class="banana" d="M86,73 Q106,60 126,70 Q107,68 86,73 Z" stroke-width="0.9"/>
      <path class="banana-line" d="M92,71 Q107,64 119,69" stroke-width="0.6"/>
      <path class="banana-stem" d="M126,70 L130,67" stroke-width="1.1"/>
      <g class="zzz" stroke-width="1.1" opacity="0.5">
        <path d="M74,16 L82,16 L74,24 L82,24"/>
        <path d="M88,6 L94,6 L88,12 L94,12"/>
      </g>
    </g>
  </svg>

  <p class="foot-line">Shahar &amp; Kyle <span class="dot">&middot;</span> 5 June 2027</p>
  <a class="foot-src" href="https://github.com/kdmccormick/shaharkyle.com" target="_blank" rel="noopener">source code on github</a>
</footer>

</body>
</html>

<style is:global>
/* ══ TOKENS ═══════════════════════════════════════════════
   Warm and low-lit: the Armory's brick, string lights, and
   the last of the sun off the Seine.
   ═════════════════════════════════════════════════════════ */
:root {
  --ink:        #2b1f15;
  --ink-soft:   #5c4630;
  --ink-faint:  #8b7250;

  --paper:      #e7d8bd;
  --paper-2:    #dccbaa;
  --paper-edge: #c2ac83;

  --amber:      #b8761f;
  --gold:       #dda94f;
  --rust:       #964223;

  --rule:       rgba(43,31,21,0.22);
  --rule-soft:  rgba(43,31,21,0.12);

  /* marcy: black semi-longhair, white chest bib, green eyes, one banana */
  --marcy-fur:  #26231e;
  --marcy-eye:  #b7c76d;
  --marcy-bib:  #ece7db;
  --banana:     #d4bb4e;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { font-size: 18px; }

body {
  font-family: 'Newsreader', Georgia, serif;
  line-height: 1.6;
  color: var(--ink);
  background-color: var(--paper);
  background-image:
    repeating-linear-gradient(0deg,  rgba(43,31,21,0.016) 0 1px, transparent 1px 3px),
    repeating-linear-gradient(90deg, rgba(43,31,21,0.012) 0 1px, transparent 1px 4px);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--rust); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }

.dot { color: var(--ink-faint); margin: 0 0.4rem; }

/* ══ PASSWORD WALL ════════════════════════════════════════ */
#pw-wall {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: var(--paper);
}
.pw-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.3rem;
  width: 100%;
  max-width: 340px;
  padding: 2.5rem 2.25rem;
  background: var(--paper);
  border: 1px solid var(--paper-edge);
  outline: 3px double var(--paper-edge);
  outline-offset: 5px;
  box-shadow: 6px 7px 0 rgba(43,31,21,0.13);
}
.pw-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 1.85rem;
  letter-spacing: 0.03em;
  line-height: 1.15;
}
.pw-sub {
  font-style: italic;
  color: var(--ink-soft);
  font-size: 0.9rem;
  margin-bottom: 1rem;
}
.pw-prompt {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 0.4rem;
}
.pw-caret {
  font-family: 'Space Mono', monospace;
  color: var(--rust);
  font-size: 1.1rem;
  animation: blink 1.1s step-end infinite;
}
@keyframes blink { 0%,100% { opacity: 1 } 50% { opacity: 0 } }
#pw-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--ink);
  font-family: 'Space Mono', monospace;
  font-size: 0.95rem;
  letter-spacing: 0.22em;
  caret-color: var(--rust);
}
#pw-input::placeholder { color: var(--ink-faint); letter-spacing: 0.12em; }
.pw-error {
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  color: var(--rust);
  min-height: 1.3em;
  margin-top: 0.5rem;
}
.pw-hint { font-style: italic; font-size: 0.78rem; color: var(--ink-faint); }

/* ══ PHOTO STRIP, WITH THE LIGHTS OVER IT ═════════════════
 * Every photo renders at the same height, tiled flush, drifting left.
 * The list is duplicated in the markup so the loop is seamless: the track
 * animates to -50%, which lands exactly on the start of the second copy.
 * ═════════════════════════════════════════════════════════ */
.strip-wrap {
  position: relative;
  width: 100%;
}
.marquee {
  position: relative;
  width: 100%;
  height: clamp(230px, 34vh, 360px);
  overflow: hidden;
  background: var(--paper-2);
  -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
          mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
}
.marquee-track {
  display: flex;
  height: 100%;
  width: max-content;
  will-change: transform;
  animation: marquee-drift var(--dur, 120s) linear infinite;
}
/*
 * Spacing is a trailing margin, not `gap`. With `gap` the track has 2N-1
 * gaps, so -50% lands half a gap short of the second copy and the loop
 * visibly jumps. A margin on every image gives 2N even gaps — exact.
 */
.marquee-track img {
  height: 100%;
  width: auto;
  flex: none;
  display: block;
  object-fit: cover;
  margin-right: 5px;
}
@keyframes marquee-drift {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(-50%, 0, 0); }
}
.marquee:hover .marquee-track { animation-play-state: paused; }

/* the lights hang in front of the photos */
.festoon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 100%;
  height: 58px;
  pointer-events: none;
}
.festoon .wire { fill: none; stroke: rgba(22,18,14,0.55); stroke-width: 1.2; }
.bulb line   { stroke: rgba(22,18,14,0.5); stroke-width: 1.1; }
.bulb circle {
  fill: var(--gold);
  stroke: rgba(90,58,16,0.4);
  stroke-width: 0.8;
  filter: drop-shadow(0 0 6px rgba(221,169,79,0.95));
  animation: bulb-glow 4.5s ease-in-out infinite;
}
@keyframes bulb-glow { 0%,100% { opacity: 0.85 } 50% { opacity: 1 } }

/* ══ TITLES ═══════════════════════════════════════════════ */
main {
  max-width: 640px;
  margin: 0 auto;
  padding: 3rem 1.5rem 4rem;
}
.titles { text-align: center; margin-bottom: 2.5rem; }
.titles h1 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: clamp(2.6rem, 8vw, 4.2rem);
  line-height: 1.1;
  letter-spacing: 0.02em;
}
.titles .amp { font-style: italic; color: var(--amber); padding: 0 0.1em; }
.save {
  font-family: 'Space Mono', monospace;
  font-size: 0.66rem;
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-top: 0.9rem;
}

/* ══ THE CARD ═════════════════════════════════════════════ */
.card {
  background: var(--paper);
  border: 1px solid var(--paper-edge);
  box-shadow: 5px 6px 0 rgba(43,31,21,0.13);
  transform: rotate(-0.35deg);
}
.venue { margin: 0; }
.venue img {
  display: block;
  width: 100%;
  height: auto;
  border-bottom: 1px solid var(--paper-edge);
  filter: saturate(0.96);
}
.facts {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  gap: 0 2rem;
  padding: 2rem 2.25rem;
  text-align: center;
  align-items: start;
}
.rule {
  align-self: stretch;
  background: repeating-linear-gradient(to bottom, var(--rule) 0 5px, transparent 5px 10px);
}
.fact h2 {
  font-family: 'Space Mono', monospace;
  font-weight: 400;
  font-size: 0.6rem;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 0.6rem;
}
.big {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  font-size: 1.5rem;
  line-height: 1.25;
}
.big a { color: inherit; border-bottom: 1px solid rgba(150,66,35,0.45); }
.big a:hover { color: var(--rust); text-decoration: none; }
.sub {
  margin-top: 0.5rem;
  font-size: 0.92rem;
  line-height: 1.55;
  color: var(--ink-soft);
}

/* ══ FOOTER ═══════════════════════════════════════════════ */
footer { text-align: center; padding: 0 1.5rem 3rem; color: var(--ink-soft); }
.marcy-sleep {
  width: 150px;
  height: auto;
  display: block;
  margin: 0 auto 1rem;
  color: var(--ink-soft);
}
.cat-fill    { fill: var(--marcy-fur); }
.cat-lash    { stroke: var(--marcy-eye); }
.cat-bib     { fill: var(--marcy-bib); stroke: none; }
.cat-whisker { stroke: var(--marcy-bib); opacity: 0.55; }
.banana      { fill: var(--banana); stroke: #8a7420; }
.banana-line { stroke: #8a7420; opacity: 0.5; }
.banana-stem { stroke: #6f5c1c; }
.zzz { animation: zzz-float 4.2s ease-in-out infinite; }
@keyframes zzz-float {
  0%,100% { opacity: 0.25; transform: translateY(2px); }
  50%     { opacity: 0.65; transform: translateY(-3px); }
}
.foot-line {
  font-family: 'Space Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
}
.foot-src {
  display: inline-block;
  margin-top: 0.9rem;
  font-family: 'Space Mono', monospace;
  font-size: 0.56rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
.foot-src:hover { color: var(--rust); text-decoration: none; }

/* ══ FADE-IN ══════════════════════════════════════════════ */
.fade-in {
  opacity: 0;
  transform: translateY(16px) rotate(-0.35deg);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.fade-in.visible { opacity: 1; transform: translateY(0) rotate(-0.35deg); }

/* ══ RESPONSIVE ═══════════════════════════════════════════ */
@media (max-width: 620px) {
  html { font-size: 17px; }
  .marquee { height: clamp(190px, 28vh, 250px); }
  .festoon { height: 46px; }
  main { padding: 2.25rem 1.1rem 3rem; }
  .facts { grid-template-columns: 1fr; gap: 1.5rem 0; padding: 1.6rem 1.25rem; }
  .rule { height: 1px; background: repeating-linear-gradient(to right, var(--rule) 0 5px, transparent 5px 10px); }
  .marcy-sleep { width: 124px; }
}

@media (prefers-reduced-motion: reduce) {
  .bulb circle, .zzz { animation: none; }
  .marquee-track { animation: none; }
  .marquee { overflow-x: auto; }
  .fade-in { transition: none; }
}
</style>

<script>
// ── PASSWORD WALL ─────────────────────────────────────────
const KEY  = 'sk-auth-v1';
const PASS = '060527';
const wall = document.getElementById('pw-wall');
const inp  = document.getElementById('pw-input');
const err  = document.getElementById('pw-error');

const unlock = () => { wall.style.display = 'none'; };
if (localStorage.getItem(KEY) === '1') unlock();

inp.addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  if (inp.value === PASS) {
    localStorage.setItem(KEY, '1');
    unlock();
  } else {
    err.textContent = '[ not quite ]';
    inp.value = '';
    setTimeout(() => { err.textContent = ''; }, 2000);
  }
});
if (wall.style.display !== 'none') inp.focus();

// ── PHOTO MARQUEE ─────────────────────────────────────────
// Duration is derived from the track width so the strip drifts at a fixed
// px/sec no matter how many photos are in the list.
const track = document.getElementById('marquee-track');
const PX_PER_SEC = 22;

function setMarqueeSpeed() {
  const half = track.scrollWidth / 2;
  if (half > 0) track.style.setProperty('--dur', `${half / PX_PER_SEC}s`);
}

setMarqueeSpeed();
window.addEventListener('load', setMarqueeSpeed);
window.addEventListener('resize', setMarqueeSpeed, { passive: true });
track.querySelectorAll('img').forEach(img => {
  if (!img.complete) img.addEventListener('load', setMarqueeSpeed, { once: true });
});

// ── FADE-IN ───────────────────────────────────────────────
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
  });
}, { threshold: 0.08 });
document.querySelectorAll('.fade-in').forEach(el => io.observe(el));
</script>
