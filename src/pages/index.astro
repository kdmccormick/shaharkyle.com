  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.nav-title {
  font-family: 'Space Mono', monospace;
  font-size: 0.9rem;
  letter-spacing: 0.15em;
  color: var(--axon);
}
.nav-title:hover { text-decoration: none; opacity: 0.75; }
nav ul { list-style: none; display: flex; gap: 0.1rem; flex-wrap: wrap; }
