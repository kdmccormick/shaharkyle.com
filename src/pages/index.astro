  transition: background 0.15s, color 0.15s;
}
.hero-cta:hover { background: var(--axon); color: var(--void); text-decoration: none; }

/* ── DOODLE STRIP ────────────────────────────────────── */
.doodle-strip {
  max-width: 640px;
  margin: 0 auto;
  padding: 0 1.5rem;
  color: var(--muted);
}
.doodle-svg { width: 100%; height: auto; display: block; }
.steam { animation: steam-rise 3.2s ease-in-out infinite; }
@keyframes steam-rise {
  0%,100% { opacity: 0.15; transform: translateY(2px); }
  50%     { opacity: 0.6;  transform: translateY(-3px); }
}
.marcy-eye { animation: marcy-blink 6s step-end infinite; transform-origin: center; }
@keyframes marcy-blink { 0%,96% { opacity: 1; } 97%,99% { opacity: 0.08; } 100% { opacity: 1; } }
.zzz { animation: zzz-float 4s ease-in-out infinite; }
@keyframes zzz-float {
  0%,100% { opacity: 0.25; transform: translateY(2px); }
  50%     { opacity: 0.7;  transform: translateY(-3px); }
}

/* ── MAIN / CARDS ────────────────────────────────────── */
main {
  max-width: 760px;
  margin: 0 auto;
  padding: 1.5rem 1.5rem 5rem;
  display: flex;
  flex-direction: column;
  gap: 2.4rem;
}

/*
 * Cards read like photocopied zine pages taped to a wall:
 * a hair off-axis, hard-edged drop shadow, no soft gradients.
 */
.card {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent, var(--axon));
  padding: 2rem 2.25rem;
  box-shadow: 5px 5px 0 rgba(0,0,0,0.38);
}

/* per-card accent + a slightly different tilt each time */
#details  { --accent: var(--neuron);  --rot: -0.45deg; }
#us       { --accent: var(--gold);    --rot:  0.35deg; }
#timeline { --accent: var(--cosmic);  --rot: -0.25deg; }
#rsvp     { --accent: var(--axon);    --rot:  0.4deg;  }

.card h2 {
  font-family: 'Space Mono', monospace;
  font-size: 0.72rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent, var(--axon));
  margin-bottom: 1.4rem;
  padding-bottom: 0.6rem;
  border-bottom: 1px dashed rgba(107,122,153,0.28);
}
.pre { color: var(--muted); margin-right: 0.4rem; opacity: 0.7; }
.card p, .card dd { font-size: 1rem; line-height: 1.7; }
.card h3 {
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.5rem;
}

/* ── DETAILS / SAVE THE DATE ─────────────────────────── */
/* faint coffee ring, because there is always a coffee ring */
#details::after {
  content: '';
  position: absolute;
  top: -18px;
  right: 26px;
  width: 74px;
  height: 74px;
  border: 2px solid var(--neuron);
  border-radius: 50%;
  opacity: 0.07;
  pointer-events: none;
}
.details-grid {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  gap: 0 2rem;
  text-align: center;
}
.detail-rule {
  background: repeating-linear-gradient(
    to bottom,
    rgba(107,122,153,0.3) 0 4px,
    transparent 4px 9px
  );
}
.detail-big {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 1.45rem;
  line-height: 1.25;
  color: var(--text);
  letter-spacing: -0.01em;
}
.detail-year {
  font-family: 'Space Mono', monospace;
  font-weight: 400;
  font-size: 0.85rem;
  letter-spacing: 0.2em;
  color: var(--muted);
}
.detail-big a { color: inherit; border-bottom: 1px dashed rgba(107,122,153,0.5); }
.detail-big a:hover { color: var(--neuron); text-decoration: none; }
.detail-sub {
  margin-top: 0.55rem;
  font-size: 0.88rem !important;
  line-height: 1.5 !important;
  color: var(--muted);
}
.details-note {
  margin-top: 1.6rem;
  padding-top: 1.1rem;
  border-top: 1px dashed rgba(107,122,153,0.22);
  font-style: italic;
  color: var(--muted);
  font-size: 0.95rem;
  text-align: center;
}

/* ── PHOTO ───────────────────────────────────────────── */
.photo-figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }

/* taped-up print, tilted */
.photo-frame {
  position: relative;
  width: 100%;
  max-width: 440px;
  padding: 12px 12px 46px;
  background: #e8e4da;
  transform: rotate(-1.4deg);
  box-shadow: 6px 7px 0 rgba(0,0,0,0.42);
}
/* strips of tape at the top corners */
.photo-frame::before,
.photo-frame::after {
  content: '';
  position: absolute;
  top: -13px;
  width: 66px;
  height: 26px;
  background: rgba(200, 224, 220, 0.22);
  border-left: 1px solid rgba(255,255,255,0.16);
  border-right: 1px solid rgba(255,255,255,0.16);
}
.photo-frame::before { left: -14px;  transform: rotate(-26deg); }
.photo-frame::after  { right: -14px; transform: rotate(24deg); }

.photo-img {
  display: block;
  width: 100%;
  height: auto;
  filter: saturate(0.92) contrast(1.04);
}
.photo-placeholder {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  aspect-ratio: 4 / 3;
  color: #7d7566;
  background: repeating-linear-gradient(
    45deg,
    rgba(0,0,0,0.035) 0 9px,
    transparent 9px 18px
  );
}
.photo-frame.is-empty .photo-img { display: none; }
.photo-frame.is-empty .photo-placeholder { display: flex; }
.ph-svg { width: 74px; height: 74px; opacity: 0.5; }
.ph-text {
  font-family: 'Space Mono', monospace;
  font-size: 0.62rem !important;
  letter-spacing: 0.08em;
  text-align: center;
  padding: 0 1rem;
}
.ph-text code {
  background: rgba(0,0,0,0.07);
  padding: 0.1rem 0.3rem;
}
.photo-figure figcaption {
  font-family: 'Crimson Text', serif;
  font-style: italic;
  font-size: 0.9rem;
  color: var(--muted);
  text-align: center;
  margin-top: 0.35rem;
}

/* ── STORY TIMELINE ──────────────────────────────────── */
.story-timeline {
  list-style: none;
  position: relative;
  padding-left: 1.9rem;
  display: flex;
  flex-direction: column;
  gap: 1.6rem;
}
/* the connecting axon */
.story-timeline::before {
  content: '';
  position: absolute;
  left: 5px;
  top: 6px;
  bottom: 6px;
  width: 1px;
  background: linear-gradient(
    to bottom,
    var(--neuron) 0%,
    var(--cosmic) 55%,
    var(--gold)   100%
  );
  opacity: 0.4;
}
.story-timeline li { position: relative; }
/* synapse node */
.story-timeline li::before {
  content: '';
  position: absolute;
  left: -1.9rem;
  top: 6px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--void);
  border: 2px solid var(--cosmic);
}
.story-timeline li:nth-child(1)::before { border-color: var(--neuron); }
.story-timeline li:nth-child(2)::before { border-color: var(--neuron); }
.story-timeline li:nth-child(3)::before { border-color: var(--axon); }
.story-timeline li:nth-child(4)::before { border-color: var(--organic); }
.story-timeline li:nth-child(5)::before { border-color: var(--cosmic); }

/* the wedding: a filled, glowing star instead of a node */
.story-timeline li.st-future::before {
  background: var(--gold);
  border-color: var(--gold);
  box-shadow: 0 0 10px 2px rgba(245,197,66,0.5);
}
.st-date {
  display: block;
  font-family: 'Space Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  color: var(--muted);
  margin-bottom: 0.2rem;
}
.st-title {
  font-family: 'Syne', sans-serif !important;
  font-weight: 800;
  font-size: 1.02rem !important;
  letter-spacing: 0 !important;
  text-transform: none !important;
  color: var(--text) !important;
  margin-bottom: 0.15rem !important;
}
.st-body p { color: var(--muted); font-size: 0.97rem; }
.st-future .st-title { color: var(--gold) !important; }

/* RSVP form */
.rsvp-dead {
  font-family: 'Space Mono', monospace;
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  color: var(--muted);
  margin-bottom: 1.5rem;
}
.rsvp-form { display: flex; flex-direction: column; gap: 1.1rem; }
.fg { display: flex; flex-direction: column; gap: 0.3rem; }
.fg label {
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
}
.req { color: var(--neuron); }
.fg input[type="text"],
.fg input[type="email"],
.fg input[type="number"],
.fg textarea {
  width: 100%;
  padding: 0.5rem 0.65rem;
  background: rgba(78,205,196,0.04);
  border: 1px solid var(--border);
  color: var(--text);
  font-family: 'Crimson Text', serif;
  font-size: 1rem;
  caret-color: var(--axon);
  transition: border-color 0.15s;
  -webkit-appearance: none;
}
.fg input:focus, .fg textarea:focus {
  outline: none;
  border-color: var(--axon);
  background: rgba(78,205,196,0.07);
}
.fg textarea { resize: vertical; }
.fg input[type="number"] { max-width: 7rem; }
.radios { display: flex; gap: 1.5rem; flex-wrap: wrap; }
.rl {
  display: flex; align-items: center; gap: 0.4rem;
  cursor: pointer;
  font-family: 'Crimson Text', serif;
  font-size: 1rem;
  color: var(--text);
}
.rl input[type="radio"] { accent-color: var(--axon); }
.submit-btn {
  align-self: flex-start;
  padding: 0.6rem 1.8rem;
  background: transparent;
  border: 1.5px solid var(--axon);
  color: var(--axon);
  font-family: 'Space Mono', monospace;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}
.submit-btn:hover { background: var(--axon); color: var(--void); }

/* ── FOOTER ──────────────────────────────────────────── */
footer {
  text-align: center;
  padding: 0 2rem 2.5rem;
  font-family: 'Space Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  color: var(--muted);
  text-transform: uppercase;
}
.marcy-sleep {
  width: 150px;
  height: auto;
  display: block;
  margin: 0 auto 0.75rem;
  opacity: 0.85;
}
.foot-line { margin-bottom: 0.4rem; }
.foot-hex { color: var(--border); margin: 0 0.75rem; }
.foot-marcy {
  font-size: 0.58rem;
  letter-spacing: 0.14em;
  opacity: 0.4;
  text-transform: lowercase;
  font-style: italic;
}
.foot-src {
  display: inline-block;
  margin-top: 0.8rem;
  font-size: 0.6rem;
  color: var(--muted);
  opacity: 0.45;
  letter-spacing: 0.15em;
}
.foot-src:hover { opacity: 1; text-decoration: none; color: var(--axon); }

/* ── FADE-IN ─────────────────────────────────────────── */
/* keeps each card's tilt (--rot) through the animation */
.fade-in {
  opacity: 0;
  transform: translateY(20px) rotate(var(--rot, 0deg));
  transition: opacity 0.55s ease, transform 0.55s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0) rotate(var(--rot, 0deg));
}

/* ── RESPONSIVE ──────────────────────────────────────── */
@media (max-width: 600px) {
  .card { padding: 1.5rem 1.1rem; box-shadow: 3px 3px 0 rgba(0,0,0,0.38); }
  .details-grid { grid-template-columns: 1fr; gap: 1.25rem 0; }
  .detail-rule { display: none; }
  .radios { flex-direction: column; gap: 0.5rem; }
  .pw-box { padding: 2rem 1.5rem; }
  .photo-frame { padding: 9px 9px 34px; }
  .doodle-strip { padding: 0 0.75rem; }
  .marcy-sleep { width: 118px; }
}

/* respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  .soma, .hub-pulse, .hub-ring, .star-t, .steam, .zzz, .marcy-eye { animation: none; }
  .fade-in { transition: none; }
}
</style>

<script>
// ── PASSWORD WALL ──────────────────────────────────────
const KEY  = 'sk-auth-v1';
const PASS = '060527';
const wall = document.getElementById('pw-wall');
const inp  = document.getElementById('pw-input');
const err  = document.getElementById('pw-error');

function unlock() { wall.style.display = 'none'; }
if (localStorage.getItem(KEY) === '1') unlock();

inp.addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  if (inp.value === PASS) {
    localStorage.setItem(KEY, '1');
    unlock();
  } else {
    err.textContent = '[ incorrect ]';
    inp.value = '';
    setTimeout(() => { err.textContent = ''; }, 2000);
  }
});

// Focus input when wall is visible
if (wall.style.display !== 'none') inp.focus();

// ── NAV SCROLL ────────────────────────────────────────
const hdr = document.getElementById('site-header');
window.addEventListener('scroll', () => {
  hdr.classList.toggle('scrolled', window.scrollY > 50);
}, { passive: true });

// ── FADE-IN ───────────────────────────────────────────
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
}, { threshold: 0.08 });
document.querySelectorAll('.fade-in').forEach(el => io.observe(el));

// ── PHOTO FALLBACK ────────────────────────────────────
// Shows the placeholder until public/images/us.jpg exists.
const photo = document.getElementById('us-photo');
const frame = photo.closest('.photo-frame');
const markEmpty = () => frame.classList.add('is-empty');
photo.addEventListener('error', markEmpty);
if (photo.complete && photo.naturalWidth === 0) markEmpty();

// ── RSVP CONDITIONAL FIELDS ───────────────────────────
const extra = ['r-guests','r-diet','r-song'].map(id => document.getElementById(id));
document.querySelectorAll('input[name="attending"]').forEach(r =>
  r.addEventListener('change', () => {
    const yes = document.querySelector('input[name="attending"]:checked')?.value === 'yes';
    extra.forEach(el => { el.style.display = yes ? 'flex' : 'none'; });
  })
);
</script>
