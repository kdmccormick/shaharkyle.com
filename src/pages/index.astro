<style is:global>
/* ── TOKENS ─────────────────────────────────────────── */
:root {
  --void:    #090b12;
  --surface: #0f1219;
  --border:  rgba(78,205,196,0.18);
  --text:    #dde4f0;
  --muted:   #6b7a99;
  --neuron:  #ff6b35;
  --axon:    #4ecdc4;
  --cosmic:  #b57bee;
  --organic: #95c97a;
  --gold:    #f5c542;
}

/* ── RESET ───────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 18px; }

body {
  font-family: 'Crimson Text', Georgia, serif;
  color: var(--text);
  background-color: var(--void);
  /* hex-dot grid: two offset layers of dots create a honeycomb pattern */
  background-image:
    radial-gradient(circle, rgba(78,205,196,0.11) 1px, transparent 1px),
    radial-gradient(circle, rgba(78,205,196,0.07) 1px, transparent 1px);
  background-size: 28px 48px, 28px 48px;
  background-position: 0 0, 14px 24px;
  min-height: 100vh;
}

a { color: var(--axon); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ── PASSWORD WALL ───────────────────────────────────── */
#pw-wall {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--void);
  display: flex;
  align-items: center;
  justify-content: center;
  background-image:
    radial-gradient(circle, rgba(78,205,196,0.11) 1px, transparent 1px),
    radial-gradient(circle, rgba(78,205,196,0.07) 1px, transparent 1px);
  background-size: 28px 48px, 28px 48px;
  background-position: 0 0, 14px 24px;
}
.pw-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  border: 1px solid var(--border);
  border-left: 3px solid var(--axon);
  padding: 2.5rem 3rem;
  max-width: 340px;
  width: 90%;
}
.pw-label {
  font-family: 'Space Mono', monospace;
  font-size: 0.75rem;
  letter-spacing: 0.3em;
  color: var(--axon);
}
.pw-sub {
  font-family: 'Crimson Text', serif;
  font-style: italic;
  color: var(--muted);
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}
.pw-prompt {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.4rem;
  margin-top: 0.75rem;
}
.pw-caret {
  font-family: 'Space Mono', monospace;
  color: var(--axon);
  font-size: 1.1rem;
  animation: blink 1s step-end infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

#pw-input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  font-family: 'Space Mono', monospace;
  font-size: 1rem;
  caret-color: var(--axon);
  width: 100%;
  letter-spacing: 0.2em;
}
.pw-error {
  font-family: 'Space Mono', monospace;
  font-size: 0.75rem;
  color: var(--neuron);
  letter-spacing: 0.15em;
  min-height: 1.2em;
}
.pw-hint {
  font-family: 'Crimson Text', serif;
  font-style: italic;
  color: var(--muted);
  font-size: 0.8rem;
  margin-top: 0.25rem;
}

/* ── NAV ─────────────────────────────────────────────── */
#site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 0.7rem 2rem;
  transition: background 0.3s, backdrop-filter 0.3s;
}
#site-header.scrolled {
  background: rgba(9,11,18,0.88);
