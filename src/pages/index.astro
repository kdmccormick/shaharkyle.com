---
/*
 * Shahar & Kyle - save the date.
 *
 * The drawing is the site. It was photographed, cropped and knocked out onto
 * transparency (tools/process_flyer.py), so what you see is graphite sitting
 * directly on the page's own paper - not a white card floating on a
 * background. It is left at the angle it was shot at, on purpose.
 *
 * The background is wood grain, painted on a canvas at runtime by
 * src/woodgrain.js. Every block marked `data-clearing` becomes a plateau in
 * the field the grain contours, so the grain parts and flows around it. That
 * has to happen in the browser: the clearings need the positions the content
 * actually landed at, which depend on viewport width and font loading.
 */
const photos = [
  { src: '/images/seine.jpg',    alt: 'On a bridge over the Seine at sunset' },
  { src: '/images/forest.jpg',   alt: 'A kiss on the cheek in the winter woods' },
  { src: '/images/ornament.jpg', alt: 'The two of us reflected in a silver ornament' },
  { src: '/images/yurt.jpg',     alt: 'Bundled up outside a yurt in the snow' },
];

const MAPS = 'https://maps.google.com/?q=Arts+at+the+Armory,+191+Highland+Ave,+Somerville,+MA+02143';

// Marcy is generated by tools/draw_marcy.py and inlined rather than linked, so
// her tail and paws can be animated from the stylesheet.
import marcySvg from '../marcy-run.svg?raw';
import marcySleepSvg from '../marcy-sleep.svg?raw';
import marcyPeekSvg from '../marcy-peek.svg?raw';

// 5pm-11pm Eastern on the day, as UTC
const CAL = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
  + '&text=' + encodeURIComponent('Shahar & Kyle are getting married')
  + '&dates=20270605T210000Z/20270606T030000Z'
  + '&location=' + encodeURIComponent('Arts at the Armory, 191 Highland Ave, Somerville, MA 02143')
  + '&details=' + encodeURIComponent('Save the date. Details to follow.');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Shahar & Kyle are getting married — June 5, 2027 at Arts at the Armory in Somerville, MA." />
  <title>Shahar &amp; Kyle are getting married</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Special+Elite&display=swap" rel="stylesheet" />
</head>

<body>

<!-- ═══ PASSWORD WALL ═══════════════════════════════════ -->
<div id="pw-wall">
  <div class="pw-box">
    <img class="pw-curl tl" src="/images/orn-corner.svg" alt="" aria-hidden="true" />
    <img class="pw-curl br" src="/images/orn-corner.svg" alt="" aria-hidden="true" />
    <h2 class="pw-title">Shahar <span class="amp">&amp;</span> Kyle</h2>
    <p class="pw-sub">still being drawn</p>
    <div class="pw-prompt">
      <span class="pw-caret">&rsaquo;</span>
      <input type="password" id="pw-input" autocomplete="off" maxlength="12" spellcheck="false" placeholder="access code" />
    </div>
    <p id="pw-error" class="pw-error"></p>
    <p class="pw-hint">press enter</p>
  </div>
</div>

<div class="page">

  <!-- the pools of dawn light the text is read by, under the grain -->
  <canvas id="glow" aria-hidden="true"></canvas>
  <!-- the grain fills this box entirely and parts around every [data-clearing] -->
  <canvas id="grain" aria-hidden="true"></canvas>
  <!-- just the flares on the bright chart stars, so they can twinkle without
       the grain underneath being repainted every frame -->
  <canvas id="twinkle" aria-hidden="true"></canvas>

  <main>

    <!-- ═══ THE DRAWING ═════════════════════════════════ -->
    <section class="flyer" data-clearing>
      <picture>
        <source
          type="image/webp"
          srcset="/images/flyer-ink-900.webp 900w, /images/flyer-ink-1500.webp 1500w"
          sizes="(max-width: 620px) 88vw, (max-width: 760px) 70vw, 536px" />
        <img
          src="/images/flyer-ink.png"
          width="1500" height="1645"
          alt="A hand-drawn flyer: Save the Date — we're getting married on June 5, 2027, around 5PM, at Arts at the Armory, 191 Highland Ave, Somerville MA, over a pencil drawing of the Armory building."
          fetchpriority="high" />
      </picture>
    </section>

    <!-- ═══ THE TWO OF US ═══════════════════════════════ -->
    <section class="strip-wrap" data-clearing>
      <div class="marquee">
        <!--
          One set of photos, twice, so there is something to look at before
          the script runs. It clones this further at runtime until the row is
          wider than the screen - see PHOTO MARQUEE below for why.
        -->
        <div class="marquee-track" id="marquee-track" data-count={photos.length}>
          {photos.map(p => <img src={p.src} alt={p.alt} />)}
          {photos.map(p => <img src={p.src} alt="" aria-hidden="true" />)}
        </div>
      </div>
    </section>

    <!-- ═══ WHO, AND WHY ════════════════════════════════ -->
    <header class="titles" data-clearing>
      <h1>Shahar <span class="amp">&amp;</span> Kyle</h1>
      <p class="are">are getting married</p>
    </header>

    <!--
      The banana sits here twitching until somebody throws it. That is what
      brings Marcy out - she is hiding off the left edge of the screen with one
      paw and her tail showing.
    -->
    <p class="throw-row" id="throw-row">
      <button type="button" class="throw" id="throw-btn">throw the banana</button>
      <svg class="throw-banana" viewBox="0 0 44 30" aria-hidden="true">
        <path d="M6,21 Q17,3 36,9 Q20,12 9,25 Z" />
        <path class="stem" d="M36,9 l5,-3" />
      </svg>
    </p>

    <!-- the same facts, in text a screen reader and a phone can use -->
    <section class="facts" data-clearing>
      <p class="fact">
        <span class="circled">
          Saturday, June 5, 2027
          <img src="/images/orn-ring.svg" alt="" aria-hidden="true" />
        </span>
        <span class="fact-sub">around 5 in the afternoon</span>
      </p>

      <p class="fact">
        <a href={MAPS} target="_blank" rel="noopener">Arts at the Armory</a>
        <span class="fact-sub">191 Highland Ave &middot; Somerville, MA</span>
      </p>

      <p class="fact-note">
        <a class="cal" href={CAL} target="_blank" rel="noopener">put it in your calendar</a>
      </p>
    </section>

    <!-- ═══ TELL US WHERE TO SEND THE REAL ONE ══════════ -->
    <!--
      Netlify picks this form up from the built HTML and collects the entries;
      the hidden form-name field is how it knows which form a POST belongs to,
      and bot-field is a honeypot Netlify watches for spam. The submit goes over
      fetch so the page can answer inline, but the form still works as a plain
      POST if the script never runs.
    -->
    <section class="ask" data-clearing>
      <p class="ask-sub">Leave your address and we'll post you a real invitation.</p>

      <form
        class="ask-form"
        name="save-the-date"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        id="rsvp-form"
      >
        <input type="hidden" name="form-name" value="save-the-date" />
        <p class="hp">
          <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="field">
          <span>Your name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label class="field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="field">
          <span>Mailing address</span>
          <textarea name="address" rows="3" required autocomplete="street-address"></textarea>
        </label>

        <label class="field">
          <span>Anything else</span>
          <textarea
            name="extras"
            rows="3"
            placeholder="Advice, a story about us, or the one song that will get you on the dance floor."
          ></textarea>
        </label>

        <button type="submit">send it over</button>
        <p class="ask-status" id="rsvp-status" role="status" aria-live="polite"></p>
      </form>
    </section>

  </main>

  <footer data-clearing>
    <!--
      Marcy's bed. Empty while she is out running; the sleeping loaf appears
      here once you let her catch the banana. Only ever one cat on the page.
    -->
    <div class="marcy-bed" id="marcy-bed" aria-hidden="true" set:html={marcySleepSvg}></div>

    <button type="button" class="catch" id="catch-btn">catch it</button>

    <p class="foot-line">Shahar &amp; Kyle <span class="dot">&middot;</span> 5 June 2027</p>
    <a class="foot-src" href="https://github.com/kdmccormick/shaharkyle.com" target="_blank" rel="noopener">source code on github</a>
  </footer>

</div>

<!-- ═══ MARCY, CHASING A BANANA ═════════════════════════
  Fixed to the viewport and sitting under the content, so she runs round the
  screen you are looking at and passes behind the flyer and the text. The flyer
  is transparent, so you can watch her go by through the drawing.
  ═══════════════════════════════════════════════════════ -->
<div class="critters" id="critters" aria-hidden="true">

  <!-- where she waits, until the banana is thrown -->
  <div class="marcy-hide" id="marcy-hide" set:html={marcyPeekSvg}></div>

  <div class="critter" data-marcy set:html={marcySvg}></div>

  <div class="critter" data-banana>
    <svg class="banana-fly" viewBox="0 0 44 30">
      <path d="M6,21 Q17,3 36,9 Q20,12 9,25 Z" />
      <path class="stem" d="M36,9 l5,-3" />
    </svg>
  </div>

</div>

</body>
</html>

<style is:global>
/* ══ TOKENS ═══════════════════════════════════════════════
   Graphite on paper, lit like early morning: cool overhead,
   warm down at the horizon. The flyer is knocked out to
   transparency, so this sky is literally what you see through
   the drawing - everything else is tuned to it.
   ═════════════════════════════════════════════════════════ */
:root {
  /*
   * Shahar means dawn. The page is the sky just before one: deeper overhead,
   * going lighter down at the horizon.
   *
   * How light is a compromise pulling three ways. Too dark and the graphite
   * grain vanishes into it and the step up to the lit blocks is a wall; too
   * light and the off-white star chart has nothing to show against. Around
   * here the grain reads at ~2.8:1, the chart at ~4.7:1, and the sky sits
   * ~4.5:1 off the lit surface instead of the 8:1 cliff it was.
   */
  --sky-top:    #3f5474;
  --sky-mid:    #536a8a;
  --sky-low:    #6b809d;
  --sky-edge:   #33445f;   /* deeper, right at the margins */
  --sky-edge-0: rgba(51,68,95,0);   /* the same, no alpha - see below */

  /* Text sits in a pool of light, never straight on the sky. */
  --ink:        #14110f;
  --ink-soft:   #423b34;
  --ink-faint:  #655c50;   /* 5.3:1 on the lit surface; #7d7366 fell under AA */

  --accent:     #1f5561;   /* deep teal, the one spot of colour */
  --rule:       rgba(20,17,15,0.3);

  --chart:      #efece1;   /* off-white; the star chart is drawn in this */

  /* The light behind each block, in three stacked passes so it fades out over
     a distance rather than in a step. The core is what the text is actually
     read against, so it stays nearly opaque; the other two are the spill. */
  --glow-core:  rgba(246,236,212,0.94);
  --glow-mid:   rgba(242,222,178,0.5);
  --glow-halo:  rgba(233,196,126,0.26);

  --font-hand:  'Permanent Marker', 'Comic Sans MS', cursive;
  --font-type:  'Special Elite', 'Courier New', Courier, monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  font-size: 18px;
  /* The sky lives on <html> so it spans the whole document as one wash, cool
     overhead down to warm at the foot of the page. Not `fixed`: that pins the
     gradient to the viewport and leaves everything below the first screenful
     with no background at all. */
  background-color: var(--sky-mid);
  /*
   * The sky is the whole page now, with the margins falling away darker still
   * so the middle reads as the open part of it. The stops fade to
   * --sky-edge-0 rather than `transparent`: it is the same blue at zero alpha,
   * and interpolating towards a colourless transparent passes through grey.
   */
  background-image:
    linear-gradient(to right,  var(--sky-edge) 0, var(--sky-edge-0) max(22px, calc((100% - 900px) / 2))),
    linear-gradient(to left,   var(--sky-edge) 0, var(--sky-edge-0) max(22px, calc((100% - 900px) / 2))),
    linear-gradient(to bottom, var(--sky-edge) 0, var(--sky-edge-0) 220px),
    linear-gradient(to top,    var(--sky-edge) 0, var(--sky-edge-0) 300px),
    linear-gradient(
      180deg,
      var(--sky-top) 0%,
      var(--sky-mid) 52%,
      var(--sky-low) 100%
    );
  background-repeat: no-repeat;
}

body {
  font-family: var(--font-type);
  line-height: 1.6;
  color: var(--ink);
  background-color: transparent;
  /* a faint tooth, so the page reads as stock rather than a flat wash */
  background-image:
    repeating-linear-gradient(0deg,  rgba(20,17,15,0.014) 0 1px, transparent 1px 3px),
    repeating-linear-gradient(90deg, rgba(20,17,15,0.011) 0 1px, transparent 1px 4px);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }
.amp { color: var(--accent); }
.dot { color: var(--ink-faint); margin: 0 0.35rem; }

/* ══ PASSWORD WALL ════════════════════════════════════════ */
#pw-wall {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  /* opaque, so the page behind it is genuinely hidden rather than tinted */
  background: linear-gradient(180deg, var(--sky-top), var(--sky-low));
}
.pw-box {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.3rem;
  width: 100%;
  max-width: 380px;
  padding: 2.75rem 2.5rem;
  /* the box's edge is a drawn line, stretched to fit */
  border-image: url('/images/orn-frame.svg') 30 / 30px / 0 stretch;
  border-width: 30px;
  border-style: solid;
}
.pw-curl {
  position: absolute;
  width: 76px;
  opacity: 0.55;
  pointer-events: none;
}
.pw-curl.tl { top: -26px;    left: -26px; }
.pw-curl.br { bottom: -26px; right: -26px; transform: rotate(180deg); }
.pw-title {
  font-family: var(--font-hand);
  font-weight: 400;
  font-size: 2.1rem;
  line-height: 1.15;
}
.pw-sub { color: var(--ink-soft); font-size: 0.82rem; margin-bottom: 1.1rem; }
.pw-prompt {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  border-bottom: 1.5px solid var(--rule);
  padding-bottom: 0.4rem;
}
.pw-caret {
  font-family: var(--font-type);
  color: var(--accent);
  font-size: 1.1rem;
  animation: blink 1.1s step-end infinite;
}
@keyframes blink { 0%,100% { opacity: 1 } 50% { opacity: 0 } }
#pw-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--ink);
  font-family: var(--font-type);
  font-size: 0.95rem;
  letter-spacing: 0.2em;
  caret-color: var(--accent);
}
#pw-input::placeholder { color: var(--ink-faint); letter-spacing: 0.1em; }
.pw-error {
  font-family: var(--font-type);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--accent);
  min-height: 1.3em;
  margin-top: 0.5rem;
}
.pw-hint { font-size: 0.72rem; color: var(--ink-faint); }

/* ══ LAYOUT ═══════════════════════════════════════════════ */
.page { position: relative; overflow-x: clip; }

/* Three layers filling the same box, all under the content and painted at the
   element's own pixel size: the light, then the grain over it, then the star
   flares on top. Stacked by document order - they all sit at z-index 0. */
#glow, #grain, #twinkle {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  user-select: none;
}

main {
  position: relative;
  z-index: 1;
  max-width: 760px;
  margin: 0 auto;
  padding: clamp(1.75rem, 5vw, 3.5rem) 1.25rem 2rem;
}

/* Everything the grain has to flow around also has to sit on top of it - and
   on top of Marcy, so she passes behind the drawing and the text. */
.flyer, .titles, .facts, .ask, .strip-wrap, footer { position: relative; z-index: 2; }

/* ══ MARCY AND THE BANANA ═════════════════════════════════ */
.critters {
  position: fixed;
  inset: 0;
  z-index: 1;              /* over the grain, under everything readable */
  pointer-events: none;
  overflow: hidden;
}
/* Positioned by JS. The element's own origin is its centre, so the transform
   can be a plain translate to a point on the path. */
.critter {
  position: absolute;
  top: 0;
  left: 0;
  will-change: transform;
}
.marcy-run  { width: 120px; height: auto; margin: -52px 0 0 -60px; overflow: visible; }
.banana-fly { width: 30px;  height: auto; margin: -10px 0 0 -15px; overflow: visible; }

/* She is almost entirely silhouette, so nearly everything is the one black. */
.marcy-run .m-fur-fill { fill: #17140f; }
.marcy-run .m-fur      { fill: #17140f; stroke: #17140f; }
.marcy-run .m-tuft     { fill: #4a4139; }   /* inside the ears */
.marcy-run .m-bib      { fill: #e6e0d2; }   /* the wisp on her chest */
.marcy-run .m-eye      { fill: #c3c765; }
.marcy-run .m-pupil    { fill: #14120e; }
.marcy-run .m-glint    { fill: #fdfbf3; }
.marcy-run .m-nose     { fill: #7d5a5e; }
.marcy-run .m-mouth {
  fill: none;
  stroke: #4a4139;
  stroke-width: 1.6;
  stroke-linecap: round;
}
.marcy-run .m-whisk path {
  fill: none;
  stroke: #f2ede0;
  stroke-width: 1.2;
  opacity: 0.8;
  stroke-linecap: round;
}

.banana-fly       { fill: #e8c33f; stroke: #7d6a1c; stroke-width: 1.4; }
.banana-fly .stem { stroke: #5f5015; stroke-width: 2.2; fill: none; stroke-linecap: round; }

/*
 * A deliberately simple trot: the whole cat bobs, the tail sways, and the paws
 * take turns lifting. A full four-legged gait cycle was tried and read as a
 * scuttle at this size - the bob alone is more legible and much cuter.
 * `transform-box: fill-box` is what makes transform-origin resolve against each
 * shape's own box rather than the whole SVG viewport.
 */
.marcy-run { animation: marcy-bob 0.42s ease-in-out infinite; }
@keyframes marcy-bob {
  0%, 100% { transform: translateY(0)     scaleY(1); }
  50%      { transform: translateY(-3.5px) scaleY(0.97); }
}

.marcy-run .m-tail {
  transform-box: fill-box;
  transform-origin: 88% 82%;
  animation: marcy-swish 1.15s ease-in-out infinite;
}
@keyframes marcy-swish {
  0%, 100% { transform: rotate(-7deg); }
  50%      { transform: rotate(9deg); }
}

.marcy-run .m-leg {
  transform-box: fill-box;
  transform-origin: 50% 10%;
  animation: marcy-step 0.42s ease-in-out infinite;
}
.marcy-run .m-leg-a { animation-delay: 0s; }
.marcy-run .m-leg-b { animation-delay: -0.105s; }
.marcy-run .m-leg-c { animation-delay: -0.21s; }
.marcy-run .m-leg-d { animation-delay: -0.315s; }
@keyframes marcy-step {
  0%, 100% { transform: translateY(0)   rotate(0deg); }
  50%      { transform: translateY(-4px) rotate(-7deg); }
}

/* mid-pounce she stretches out a little */
.critter.is-airborne .marcy-run { animation-play-state: paused; }
.critter.is-airborne .m-leg     { animation-play-state: paused; }

/* once she is in her bed the runners are done with */
.critters.is-asleep { display: none; }

/* ══ MARCY IN HIDING ══════════════════════════════════════
   Before the banana is thrown the runners are parked off-screen and all you
   get is a paw and a tail round the edge of the window. */
.critter { opacity: 0; }
.critters.is-out .critter { opacity: 1; }

.marcy-hide {
  position: absolute;
  left: 0;
  top: 58%;
  width: 96px;
  transform: translateY(-50%);
  /* peeks out, thinks better of it, peeks again */
  animation: peek 7s ease-in-out infinite;
}
.critters.is-out .marcy-hide { display: none; }
.marcy-hide svg { display: block; width: 100%; height: auto; overflow: visible; }
.marcy-peek .m-fur-fill { fill: #17140f; }
.marcy-peek .m-fur      { fill: #17140f; stroke: #17140f; }
.marcy-peek .m-toe      { fill: #3a332c; }
.marcy-peek .m-whisk path {
  fill: none;
  stroke: #f2ede0;
  stroke-width: 1.2;
  opacity: 0.7;
  stroke-linecap: round;
}
@keyframes peek {
  0%, 62%, 100% { transform: translate(-14%, -50%); }
  70%, 86%      { transform: translate(14%, -50%); }
}

/* ══ THROW THE BANANA ═════════════════════════════════════ */
.throw-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  margin-top: 1.4rem;
}
.throw-row.is-spent { display: none; }
.throw {
  padding: 0.4rem 1.2rem;
  font-family: var(--font-hand);
  font-size: 0.92rem;
  color: var(--ink);
  background: transparent;
  border: 2px solid var(--ink);
  border-radius: 2px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.throw:hover { background: var(--ink); color: var(--sky-mid); }

/* the banana fidgets every few seconds, to be noticed */
.throw-banana {
  width: 30px;
  height: auto;
  fill: #e8c33f;
  stroke: #7d6a1c;
  stroke-width: 1.4;
  transform-origin: 50% 60%;
  animation: banana-fidget 4.5s ease-in-out infinite;
}
.throw-banana .stem { stroke: #5f5015; stroke-width: 2.2; fill: none; }
@keyframes banana-fidget {
  0%, 72%, 100% { transform: rotate(0) translateY(0); }
  78%           { transform: rotate(-16deg) translateY(-5px); }
  84%           { transform: rotate(13deg)  translateY(-2px); }
  90%           { transform: rotate(-6deg)  translateY(0); }
}

/* ══ MARCY'S BED ══════════════════════════════════════════
   Empty until you catch her, then the loaf fades in. Reserving the height
   either way keeps the footer from jumping when she arrives. */
.marcy-bed {
  height: 118px;
  margin-bottom: 0.4rem;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.marcy-bed svg {
  width: 172px;
  height: auto;
  opacity: 0;
  transform: translateY(10px) scale(0.9);
  transition: opacity 0.45s ease, transform 0.45s cubic-bezier(.2,1.4,.5,1);
}
.marcy-bed.is-asleep svg { opacity: 1; transform: none; }

.marcy-sleep .m-fur-fill { fill: #17140f; }
.marcy-sleep .m-fur      { fill: #17140f; stroke: #17140f; }
.marcy-sleep .m-tuft     { fill: #4a4139; }
.marcy-sleep .m-bib      { fill: #e6e0d2; }
.marcy-sleep .m-nose     { fill: #7d5a5e; }
.marcy-sleep .m-shut {
  fill: none;
  stroke: #d8d2c4;
  stroke-width: 2.2;
  stroke-linecap: round;
}
.marcy-sleep .m-mouth {
  fill: none;
  stroke: #4a4139;
  stroke-width: 1.6;
  stroke-linecap: round;
}
.marcy-sleep .m-whisk path {
  fill: none;
  stroke: #f2ede0;
  stroke-width: 1.2;
  opacity: 0.7;
  stroke-linecap: round;
}
.marcy-sleep .m-banana      { fill: #e8c33f; stroke: #7d6a1c; stroke-width: 1.4; }
.marcy-sleep .m-banana-stem { stroke: #5f5015; stroke-width: 2.2; fill: none; }
.marcy-sleep .m-zzz {
  fill: none;
  stroke: var(--ink-soft);
  stroke-width: 2.4;
  stroke-linecap: round;
  animation: zzz-float 4.2s ease-in-out infinite;
}
@keyframes zzz-float {
  0%,100% { opacity: 0.25; transform: translateY(2px); }
  50%     { opacity: 0.7;  transform: translateY(-4px); }
}

/* ══ THE CATCH BUTTON ═════════════════════════════════════ */
.catch {
  display: inline-block;
  margin-bottom: 1.4rem;
  padding: 0.4rem 1.3rem;
  font-family: var(--font-hand);
  font-size: 0.92rem;
  color: var(--ink);
  background: transparent;
  border: 2px solid var(--ink);
  border-radius: 2px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.catch:hover { background: var(--ink); color: var(--sky-mid); }

/* ══ THE FLYER ════════════════════════════════════════════ */
/* The section carries the width, not the image: it is the [data-clearing] the
   grain parts around, so if the two disagree the light lands in the wrong
   place. On a phone it goes back to nearly full width - a quarter off an
   already narrow column leaves the handwriting too small to read. */
.flyer { width: 75%; margin-inline: auto; }
.flyer img { display: block; width: 100%; height: auto; }

/* ══ TITLES ═══════════════════════════════════════════════ */
.titles { text-align: center; margin-top: clamp(1.5rem, 4vw, 2.5rem); }
.titles h1 {
  font-family: var(--font-hand);
  font-weight: 400;
  font-size: clamp(2.4rem, 8vw, 4rem);
  line-height: 1.05;
}
.are {
  margin-top: 0.7rem;
  font-size: 0.78rem;
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: var(--ink-soft);
}

/* ══ THE FACTS, IN WORDS ══════════════════════════════════ */
.facts { text-align: center; margin-top: clamp(1.75rem, 4vw, 2.5rem); }
.fact {
  font-family: var(--font-hand);
  font-size: 1.45rem;
  line-height: 1.3;
  margin-bottom: 1.6rem;
}
.fact a { color: var(--ink); border-bottom: 2px solid rgba(31,85,97,0.45); }
.fact a:hover { color: var(--accent); text-decoration: none; }
.fact-sub {
  display: block;
  margin-top: 0.5rem;
  font-family: var(--font-type);
  font-size: 0.85rem;
  color: var(--ink-soft);
}
/* the date gets a pen circled round it */
.circled { position: relative; display: inline-block; padding: 0.3em 0.75em; }
.circled img {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  opacity: 0.85;
  pointer-events: none;
}
.fact-note { margin-top: 1.75rem; }
.cal {
  font-family: var(--font-type);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

/* ══ THE FORM ═════════════════════════════════════════════ */
.ask { text-align: center; margin-top: clamp(2.5rem, 7vw, 4.5rem); }
.ask-sub {
  margin: 0 auto 1.9rem;
  max-width: 36ch;
  font-family: var(--font-hand);
  font-size: 1.2rem;
  line-height: 1.3;
}
.ask-form { max-width: 430px; margin: 0 auto; text-align: left; }
.hp { position: absolute; left: -9999px; }   /* honeypot, for bots only */

.field { display: block; margin-bottom: 1.15rem; }
.field > span {
  display: block;
  margin-bottom: 0.35rem;
  font-size: 0.68rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.field input,
.field textarea {
  width: 100%;
  padding: 0.6rem 0.7rem;
  font-family: var(--font-type);
  font-size: 0.95rem;
  color: var(--ink);
  background: rgba(255,255,255,0.4);
  border: 2px solid var(--ink);
  border-radius: 2px;
  outline: none;
  resize: vertical;
}
.field input:focus,
.field textarea:focus {
  border-color: var(--accent);
  background: rgba(255,255,255,0.62);
}
.field textarea::placeholder { color: var(--ink-faint); line-height: 1.45; }

.ask-form button {
  display: block;
  margin: 1.6rem auto 0;
  padding: 0.6rem 2rem;
  font-family: var(--font-hand);
  font-size: 1.1rem;
  color: var(--sky-mid);
  background: var(--ink);
  border: 2px solid var(--ink);
  border-radius: 2px;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.ask-form button:hover { background: var(--accent); border-color: var(--accent); }
.ask-form button[disabled] { opacity: 0.55; cursor: default; }

.ask-status {
  min-height: 1.4em;
  margin-top: 0.9rem;
  text-align: center;
  font-size: 0.8rem;
  color: var(--accent);
}

/* ══ PHOTO STRIP ══════════════════════════════════════════
 * Every photo renders at the same height, tiled flush, drifting left.
 * The track is shifted by exactly the width of one set of photos, so the
 * next set lands where the last one started and the seam never shows.
 * That width is measured at runtime - see PHOTO MARQUEE in the script.
 * ═════════════════════════════════════════════════════════ */
/* It sits inside `main` for ordering, but breaks out of its 760px column to
   run the full width of the page the way it did before. */
.strip-wrap {
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-top: clamp(2rem, 5vw, 3rem);
}
.marquee {
  width: 100%;
  height: clamp(200px, 28vh, 310px);
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
          mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
}
.marquee-track {
  display: flex;
  height: 100%;
  width: max-content;
  will-change: transform;
  animation: marquee-drift var(--dur, 120s) linear infinite;
}
/*
 * Spacing is a trailing margin, not `gap`. With `gap` the track has 2N-1
 * gaps, so -50% lands half a gap short of the second copy and the loop
 * visibly jumps. A margin on every image gives 2N even gaps - exact.
 */
.marquee-track img {
  height: 100%;
  width: auto;
  flex: none;
  display: block;
  object-fit: cover;
  margin-right: 6px;
  filter: saturate(0.9) contrast(1.02);
}
/* --shift is one set's width in px, set by the script. Until it lands the
   strip simply holds still rather than drifting by a wrong amount. */
@keyframes marquee-drift {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(calc(-1 * var(--shift, 0px)), 0, 0); }
}

/* ══ FOOTER ═══════════════════════════════════════════════ */
footer { text-align: center; padding: 2.5rem 1.5rem 3rem; color: var(--ink-soft); }
.marcy-sleep {
  width: 140px;
  height: auto;
  display: block;
  margin: 0 auto 1rem;
  color: var(--ink-soft);
}
.cat-fill    { fill: #26231e; }
.cat-lash    { stroke: #b7c76d; }
.cat-bib     { fill: #ece7db; stroke: none; }
.cat-whisker { stroke: #ece7db; opacity: 0.55; }
.banana      { fill: #d4bb4e; stroke: #8a7420; }
.banana-line { stroke: #8a7420; opacity: 0.5; }
.banana-stem { stroke: #6f5c1c; }
.zzz { animation: zzz-float 4.2s ease-in-out infinite; }
@keyframes zzz-float {
  0%,100% { opacity: 0.25; transform: translateY(2px); }
  50%     { opacity: 0.65; transform: translateY(-3px); }
}
.foot-line { font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; }
.foot-src {
  display: inline-block;
  margin-top: 0.9rem;
  font-size: 0.58rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
.foot-src:hover { color: var(--accent); text-decoration: none; }

/* ══ RESPONSIVE ═══════════════════════════════════════════ */
@media (max-width: 620px) {
  html { font-size: 17px; }
  main { padding: 1.25rem 1rem 1.5rem; }
  .flyer { width: 94%; }
  .fact { font-size: 1.2rem; }
  .marcy-sleep { width: 118px; }
}

@media (prefers-reduced-motion: reduce) {
  .zzz { animation: none; }
  .marquee-track { animation: none; }
  .marquee { overflow-x: auto; }
}
</style>

<script>
import { installWoodGrain } from '../woodgrain.js';
import { installMarcy } from '../marcy.js';
import { installTwinkle } from '../twinkle.js';

// ── THE BACKGROUND ────────────────────────────────────────
// The grain is graphite; the star chart on top of it is off-white, so it only
// shows where the page has fallen away to dusk at the edges. Every repaint
// hands the bright stars' flares to the twinkle layer, which owns them.
//
// Both inks come from the stylesheet so the chart's colour is stated once.
const css = getComputedStyle(document.documentElement);
const pick = (name, fallback) =>
  css.getPropertyValue(name).trim() || fallback;

const INK   = pick('--ink', '#14110f');
const CHART = pick('--chart', '#efece1');
const GLOW  = pick('--glow-core', '');
const GMID  = pick('--glow-mid',  '');
const HALO  = pick('--glow-halo', '');

const twinkle = installTwinkle(document.getElementById('twinkle'), { ink: CHART });

const repaintGrain = installWoodGrain(document.getElementById('grain'), {
  seed: 20270605,
  ink: INK,
  alpha: 0.78,
  skyInk: CHART,
  skyAlpha: 1,
  glowCanvas: document.getElementById('glow'),
  glowCore: GLOW,
  glowMid: GMID,
  glowHalo: HALO,
  onSky: (flares, geom) => twinkle.set(flares, geom),
});

// ── THE CAT ───────────────────────────────────────────────
// She starts hidden. Throwing the banana brings her out; "catch it" in the
// footer puts her to bed, and the same button wakes her again.
const bed = document.getElementById('marcy-bed');
const hide = document.getElementById('marcy-hide');
const marcy = installMarcy(document.getElementById('critters'), { bed, hide });

const throwRow = document.getElementById('throw-row');
const throwBtn = document.getElementById('throw-btn');
const catchBtn = document.getElementById('catch-btn');

throwBtn.addEventListener('click', () => {
  marcy.release(throwBtn);
  throwRow.classList.add('is-spent');   // it is thrown; she has it now
  repaintGrain();                       // the row is gone, so the block shrank
});

catchBtn.addEventListener('click', () => {
  if (marcy.isAsleep()) {
    marcy.release();
    catchBtn.textContent = 'catch it';
  } else if (!marcy.isHiding()) {
    marcy.settle();
    catchBtn.textContent = 'wake her up';
    // She takes a moment to get there; the footer grows by her height when she
    // lands, so the grain's clearings need recomputing once she has settled.
    setTimeout(repaintGrain, 2400);
  }
});
// nothing to catch until she is out
catchBtn.hidden = true;
throwBtn.addEventListener('click', () => { catchBtn.hidden = false; });

// ── PASSWORD WALL ─────────────────────────────────────────
const KEY  = 'sk-auth-v1';
const PASS = '060527';
const wall = document.getElementById('pw-wall');
const inp  = document.getElementById('pw-input');
const err  = document.getElementById('pw-error');

const unlock = () => { wall.style.display = 'none'; };
if (localStorage.getItem(KEY) === '1') unlock();

inp.addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  if (inp.value === PASS) {
    localStorage.setItem(KEY, '1');
    unlock();
  } else {
    err.textContent = '[ not quite ]';
    inp.value = '';
    setTimeout(() => { err.textContent = ''; }, 2000);
  }
});
if (wall.style.display !== 'none') inp.focus();

// ── THE FORM ──────────────────────────────────────────────
// Posted over fetch so the page can answer inline instead of bouncing to
// Netlify's own success page. Without JS the form still submits normally.
const form   = document.getElementById('rsvp-form');
const status = document.getElementById('rsvp-status');

form.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = form.querySelector('button');
  btn.disabled = true;
  status.textContent = 'sending…';

  try {
    const res = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(new FormData(form)).toString(),
    });
    if (!res.ok) throw new Error(res.status);
    form.innerHTML = '<p class="ask-status">Got it — see you on June 5th.</p>';
    repaintGrain();   // the form collapsed, so its clearing moved
  } catch {
    status.textContent = 'That did not go through. Email us instead?';
    btn.disabled = false;
  }
});

/* ── PHOTO MARQUEE ─────────────────────────────────────────
 * The strip is shifted left by exactly one set of photos, so the following
 * set arrives where the last one began and the loop is invisible.
 *
 * For that to hold, the track has to stay wider than the screen for the whole
 * shift - it needs viewport + one set. Two sets of four photos come to about
 * 1000px each, which is fine on a phone but leaves bare paper trailing the
 * last photo on a wide window: the very thing that made the strip look only
 * as long as the page. So the set is cloned until there is enough of it, which
 * depends on the window and on how wide the photos turn out to be once loaded.
 * ───────────────────────────────────────────────────────── */
const track = document.getElementById('marquee-track');
const PX_PER_SEC = 22;
const perSet = Number(track.dataset.count) || 1;
const baseSet = [...track.children].slice(0, perSet);

function layoutMarquee() {
  // width of one set, margins included
  const setWidth = baseSet.reduce((w, img) =>
    w + img.getBoundingClientRect().width
      + parseFloat(getComputedStyle(img).marginRight || 0), 0);

  // images have no size yet; a later load event brings us back
  if (setWidth < 1) return;

  const need = Math.max(2, Math.ceil(window.innerWidth / setWidth) + 1);
  for (let have = track.children.length / perSet; have < need; have++) {
    for (const img of baseSet) {
      const copy = img.cloneNode(true);
      copy.alt = '';
      copy.setAttribute('aria-hidden', 'true');
      track.appendChild(copy);
    }
  }

  track.style.setProperty('--shift', `${setWidth}px`);
  track.style.setProperty('--dur', `${setWidth / PX_PER_SEC}s`);
}

layoutMarquee();
window.addEventListener('load', layoutMarquee);
window.addEventListener('resize', layoutMarquee, { passive: true });
for (const img of baseSet) {
  if (!img.complete) img.addEventListener('load', layoutMarquee, { once: true });
}
</script>
